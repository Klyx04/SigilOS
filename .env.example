# =============================================================================
# SigilOS - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values
#
# ⚠️ SECURITY WARNINGS ⚠️
# =============================================================================
# 1. NEVER commit .env files to Git (already in .gitignore)
# 2. Immediately revoke and rotate if any secret is exposed
# 3. Use different secrets for dev/beta/prod environments
# 4. ENCRYPTION_KEY must be 64 hex chars (32 bytes) - Generate ONCE per env
# 5. MetaMob API keys expire after 90 days of inactivity - Set calendar reminder!
#
# 🔐 Secret Rotation Protocol:
# - AUTH_SECRET: Rotate every 90 days or on suspected compromise
# - DISCORD_CLIENT_SECRET: Rotate via Discord Developer Portal
# - ENCRYPTION_KEY: NEVER rotate (will invalidate all encrypted tokens)
# - METAMOB_API_KEY: Regenerate if inactive \u003e 90 days
#
# 🚨 Leaked Secrets Protocol:
# If any secret is compromised:
# 1. Immediately revoke the leaked credential
# 2. Rotate all related secrets
# 3. Review access logs for unauthorized activity
# 4. Report to security@sigilos.fr
#
# 📖 Full Security Policy: See SECURITY.md
# =============================================================================

# =============================================================================
# DATABASE (Required)
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/sigilos"

# =============================================================================
# ENCRYPTION (Required in Production)
# =============================================================================
# 64 hex chars (32 bytes) for AES-256-GCM encryption of OAuth tokens
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-64-hex-char-encryption-key"

# =============================================================================
# AUTH.JS (Required)
# =============================================================================
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# Discord OAuth
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# =============================================================================
# DISCORD BOT (Required for Discord features)
# =============================================================================
DISCORD_BOT_TOKEN="your-discord-bot-token"

# Discord Webhook Signature Verification (for member lifecycle events)
# Get from Discord Developer Portal > Your App > General Information
DISCORD_PUBLIC_KEY="your-discord-app-public-key"

# =============================================================================
# METAMOB API (Required for Archimonstre module)
# =============================================================================
# Get your API key from: https://www.metamob.fr/utilisateur/mon_profil -> Tab "API"
# ⚠️ Keys expire after 90 days of inactivity!
# 
# For multi-tenant: Consider using guild-specific keys or a global service key
METAMOB_API_KEY="your-metamob-api-key"

# =============================================================================
# OPTIONAL
# =============================================================================
# Whitelist specific guilds (comma-separated Discord Guild IDs)
# Leave empty for strict deny-all, or comment out for dev mode (allow all)
# ALLOWED_GUILD_IDS="123456789012345678,987654321098765432"

# App URL for external links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis Configuration (Required for OCR Queue)
REDIS_URL="redis://localhost:6379"

# =============================================================================
# GOD PANEL (R3 anti-scout)
# =============================================================================
# Route secrète du dashboard God. En production, /god direct → 404 sauf si
# connecté avec un scope actif (redirection auto vers le secret). Fail-closed :
# si absente en prod, le panel est inaccessible.
# ⚠️ Générer un secret de ≥ 12 caractères aléatoires (ex: /mng-a7x2k9pZq4")
# Un secret court est devinable par force brute. Changer = redéploiement requis.
GOD_ROUTE="/mng-votre-route-secrete"

# Lien d'invitation Discord du bot (F-SEC-1, fail-closed si absent).
# Ex: https://discord.com/oauth2/authorize?client_id=XXX&permissions=8&scope=bot
DISCORD_BOT_INVITE_URL=""

# IP allowlist OPTIONNELLE du panel God (désactivable). Si défini et non vide,
# SEULES ces IPs (CSV) accèdent au panel. Attention : IP dynamique FAI → risque
# de se bloquer soi-même. Laisser vide pour désactiver.
# GOD_IP_ALLOWLIST="1.2.3.4,5.6.7.8"

# =============================================================================
# DEPLOYMENT 2026 (VPS)
# =============================================================================
DOMAIN_NAME="sigilos.fr"

# =============================================================================
# OCR.SPACE API (Free OCR alternative)
# =============================================================================
# Get your free API key from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY="your-ocr-space-api-key"

# Minimum confidence score (0-100) for auto-validation of proofs
# Below this threshold → Staff review required
OCR_AUTO_VALIDATE_THRESHOLD=40

# =============================================================================
# SENTRY (requis en prod/beta - Error Tracking)
# =============================================================================
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# OBLIGATOIRE : distingue les deux apps dans le dashboard Sentry.
# .env.beta → "beta" · .env.prod → "production" (jamais committés, sur VPS uniquement)
# SENTRY_ENVIRONMENT="production"
# Upload des sourcemaps au build (stack traces lisibles). Token créer sur :
# https://sentry.io → Settings → Auth Tokens (scopes : project:releases, org:read)
# SENTRY_AUTH_TOKEN="sntrys_xxx"
# SENTRY_ORG="sigilos"
# SENTRY_PROJECT="javascript-nextjs"
# Relais gratuit Sentry → Discord (l'action Discord native exige le plan Team).
# Secret comparé en temps constant (?secret=) — génère avec : openssl rand -hex 32
# SENTRY_WEBHOOK_SECRET="change-moi-32-octets-hex"
# Webhook du salon Discord staff qui reçoit les alertes (Salon → Intégrations → Webhooks)
# SENTRY_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx/yyy"
# URL à coller dans Sentry → Webhooks (Legacy) : https://beta.sigilos.fr/api/webhooks/sentry?secret=TON_SECRET

# =============================================================================
# DOFUSBOOK (galerie de stuff — relais signé)
# =============================================================================
# Dofusbook (derrière Cloudflare, bot-management) REFUSE les clients serveur :
# Node/undici, .NET, Playwright (headless ET headful) → 403 « Sorry, you have been
# blocked ». L'égress des Workers Cloudflare est challenge **par intermittence**
# (mesuré le 18/09/2026 : 403 sur un MISS, puis 200 dès la requête suivante).
# Les succès sont mis en cache **24 h** par le worker (clé stable, partagée par les
# deux routes) : un HIT ne retouche jamais Dofusbook ⇒ le mode NOMINAL est le worker
# déployé, sans aucune machine à laisser allumée.
# Le relais sur machine résidentielle reste un **secours** (le même `worker.js` lancé
# en `wrangler dev` + tunnel HTTPS) si le WAF devenait durablement strict.
#   - `wrangler dev` en local (dev)                       → http://127.0.0.1:8787
#   - tunnel `cloudflared` / Tailscale vers ce process    → https://<host>
# Le CSP (`connect-src`) suit automatiquement cette URL (voir src/lib/csp.ts).
# DOFUSBOOK_CF_WORKER_URL="https://<ton-relais>"       # ou http://127.0.0.1:8787 en dev
# DOFUSBOOK_WORKER_SECRET="secret-partagé-avec-le-worker"
# Jeton HMAC signé par SigilOS pour la route PUBLIQUE du worker (`/s/{id}`) appelée par
# le NAVIGATEUR du membre. Doit être identique à `WORKER_SIGN_SECRET` côté worker.
# Optionnel : par défaut on réutilise DOFUSBOOK_WORKER_SECRET (rien à créer).
# DOFUSBOOK_WORKER_SIGN_SECRET="secret-de-signature"
# Fallback appel direct depuis le VPS → dofusbook.net : DÉSACTIVÉ par défaut
# (inutile : bloqué — et on ne veut PAS exposer/faire flaguer l'IP du VPS).
# À mettre à "true" uniquement pour un dépannage explicite et temporaire.
DOFUSBOOK_ALLOW_VPS_FALLBACK="false"

# =============================================================================
# ASSETS DÔFUS (icônes items / sorts / monstres — proxy auto-siphon)
# =============================================================================
# Le proxy `/api/assets-dofus/{type}/{id}` sert dans cet ordre :
#   1. le cache WebP local (public/uploads/assets-dofus/*, volume `assets-prod-data`)
#   2. les assets « game data » 2x ci-dessous (ZÉRO réseau, instantané)
#   3. DofusDB (réseau — dernier recours : nouvel item pas encore siphonné)
#
# `DOFUS_ASSETS_DIR` = racine(s) contenant items_2x / spells_2x / monsters_2x
# (dump du client de jeu). Plusieurs racines possibles, séparées par « ; » ou « , ».
# Défaut (dev) : C:\Users\user\Desktop\dofus_assets (ignoré si absent).
# En prod, monter le dossier en lecture seule et le déclarer ici → plus AUCUNE
# dépendance à DofusDB pour les icônes déjà connues.
# DOFUS_ASSETS_DIR="/data/dofus_assets"
#
# Pré-remplissage du cache local (idempotent, relançable) :
#   node scripts/import-dofus-assets.cjs --type all
#   node scripts/import-dofus-assets.cjs --type spells --limit 50 --dry-run
