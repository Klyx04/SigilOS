# =============================================================================
# SigilOS - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (Required)
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/sigilos"

# =============================================================================
# AUTH.JS (Required)
# =============================================================================
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"

# Discord OAuth
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# =============================================================================
# DISCORD BOT (Required for Discord features)
# =============================================================================
DISCORD_BOT_TOKEN="your-discord-bot-token"

# =============================================================================
# METAMOB API (Required for Archimonstre module)
# =============================================================================
# Get your API key from: https://www.metamob.fr/utilisateur/mon_profil -> Tab "API"
# ⚠️ Keys expire after 90 days of inactivity!
# 
# For multi-tenant: Consider using guild-specific keys or a global service key
METAMOB_API_KEY="your-metamob-api-key"

# =============================================================================
# OPTIONAL
# =============================================================================
# Whitelist specific guilds (comma-separated Discord Guild IDs)
# Leave empty for strict deny-all, or comment out for dev mode (allow all)
# ALLOWED_GUILD_IDS="123456789012345678,987654321098765432"

# App URL for external links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis Configuration (Required for OCR Queue)
REDIS_URL="redis://localhost:6379"

# =============================================================================
# DEPLOYMENT 2026 (VPS)
# =============================================================================
DOMAIN_NAME="sigilos.fr"
OCR_SERVICE_URL="http://ocr-service:9999"
# En production (Docker), REDIS_URL devient : redis://redis:6379
