# =============================================================================
# SigilOS .gitignore - Best Practices 2026
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build

# Testing
/coverage

# Profil navigateur des captures 4K (script scripts/capture-screenshots.mjs)
.playwright-profile/

# Environment (NEVER commit secrets)
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build artifacts
*.tsbuildinfo
next-env.d.ts

# Prisma generated
/src/generated/prisma
/prisma/*.js
/prisma/seed-data/*.js
/prisma/seeds/*.js

# Deploy state files (generated by deploy.sh — never commit)
/.deploy-seed-hash.*

# Uploads (ephemeral user content & auto-siphoned cache)
/public/uploads/proofs/temp/
/public/uploads/assets-dofus/

# Vercel
.vercel

# Debug/local scripts
*.local.ts
*.local.js
debug-*.js
debug-*.mjs
test-api.mjs

# Build logs & output
build_log*.txt
lint-output.txt
lint-errors.txt
lint-results.txt
lint-output*.txt
out.txt
ts_errors.txt
tsc.txt
tsc_output.txt
typescript-errors.txt

# One-shot scripts (dev only)
/*.py
/scratch/
/tmp/

# Refactoring one-shot scripts (hors git — cf. CONTEXT.md règle scripts .ps1)
/scripts/convert-console-to-logger.ps1

# Scratch & test scripts at root (one-shot dev tools)
fix-all*.js
fix-all*.ts
run-proxy.js
scratch-test*.js
scratch-test*.ts
test-*.js
test-*.ts
logs_dump.json

# ESLint reports (generated, heavy)
eslint-report*.json
eslint-full*.json
eslint-errors*.json

# Data dumps & one-shot extraction files at root
objective.json
nebuleux-extracted-data.json
essences.json
monsters_osavora.json
dofus_audit.json
dofus_raw.*
duffus_*.html
duffus_*.png
all-turquoise-items.json
*_candidates.json
dofusdb_all_achievements.json
sylvestre_results.txt

# Test data (large JSON fixtures)
/tests/guide-opti/

# Backup files
*.backup

# Artefacts .candidate-* générés par audit.sh/maintenance.sh (jamais commités)
*.candidate-*

# Backups BDD & artefacts locaux de déploiement (jamais commités)
/backups/
*.bak-*
*.vps-local-backup

# ML/OCR trained data (heavy binary files)
*.traineddata

# Keys and certificates
*.pem
*.key
*.cert

# Discord bot node_modules
services/discord-bot/node_modules/

# Game Data Assets (too large for Git) — servis via bind mount + sync-assets.sh,
# jamais versionnés pour les NOUVEAUX fichiers ; les fichiers déjà suivis ne sont PAS untrackés.
/public/game-data/
# /public/game-data/tiles/ + /public/game-data/hd_maps/ sont couverts par la règle ci-dessus.

# Temporary files
temp_map.jpg
utf8_map.tsx

# Dossier mémo/plan de session — ne JAMAIS pousser (voir PROMPT_START.md)
/src/temp/

# Scratch and old map files
old_map*.tsx
*.debug.json
diff.txt
errors.txt
potable_map.tsx

# Security: Local Path & Key Leak Prevention (Windows/WSL)
/C:/
/mnt/
/.ssh/
**/id_rsa
**/id_ed25519
**/known_hosts
.env.local

# Private uploads
private_uploads/

# Large data dumps
*_dump.json
.gemini/

# Rapports & briefs d'audit (ponctuels, sensibles — garder en local)
/docs/audits/
AUDIT_*.md
src/audit-cyber
src/audit-infra
