# =============================================================================
# SigilOS .gitignore - Best Practices 2026
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build

# Testing
/coverage

# Environment (NEVER commit secrets)
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# Build artifacts
*.tsbuildinfo
next-env.d.ts

# Prisma generated
/src/generated/prisma

# Uploads (ephemeral user content)
/public/uploads/proofs/temp/

# Vercel
.vercel

# Debug/local scripts
*.local.ts
*.local.js
debug-*.js
debug-*.mjs
test-api.mjs

# Build logs & output
build_log*.txt
lint-output.txt

# Backup files
*.backup

# ML/OCR trained data (heavy binary files)
*.traineddata

# Keys and certificates
*.pem
*.key
*.cert

