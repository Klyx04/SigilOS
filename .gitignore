# =============================================================================
# SigilOS .gitignore - Best Practices 2026
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build

# Testing
/coverage

# Environment (NEVER commit secrets)
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build artifacts
*.tsbuildinfo
next-env.d.ts

# Prisma generated
/src/generated/prisma
/prisma/*.js
/prisma/seed-data/*.js
/prisma/seeds/*.js

# Uploads (ephemeral user content)
/public/uploads/proofs/temp/

# Vercel
.vercel

# Debug/local scripts
*.local.ts
*.local.js
debug-*.js
debug-*.mjs
test-api.mjs

# Build logs & output
build_log*.txt
lint-output.txt
lint-errors.txt
lint-results.txt
lint-output*.txt
out.txt
ts_errors.txt
tsc.txt
tsc_output.txt
typescript-errors.txt

# One-shot scripts (dev only)
/*.py
/scratch/
/tmp/

# Scratch & test scripts at root (one-shot dev tools)
fix-all*.js
fix-all*.ts
run-proxy.js
scratch-test*.js
scratch-test*.ts
test-*.js
test-*.ts
logs_dump.json

# ESLint reports (generated, heavy)
eslint-report*.json
eslint-full*.json
eslint-errors*.json

# Data dumps & one-shot extraction files at root
objective.json
nebuleux-extracted-data.json
essences.json
monsters_osavora.json
dofus_audit.json
dofus_raw.*
duffus_*.html
duffus_*.png
all-turquoise-items.json
*_candidates.json
dofusdb_all_achievements.json
sylvestre_results.txt

# Test data (large JSON fixtures)
/tests/guide-opti/

# Backup files
*.backup

# ML/OCR trained data (heavy binary files)
*.traineddata

# Keys and certificates
*.pem
*.key
*.cert

# Discord bot node_modules
services/discord-bot/node_modules/

# Game Data Assets (too large for Git)
/public/game-data/tiles/
/public/game-data/hd_maps/

# Temporary files
temp_map.jpg
utf8_map.tsx

# Scratch and old map files
old_map*.tsx
*.debug.json
diff.txt
errors.txt
potable_map.tsx

# Security: Local Path & Key Leak Prevention (Windows/WSL)
/C:/
/mnt/
/.ssh/
**/id_rsa
**/id_ed25519
**/known_hosts
.env.local

# Private uploads
private_uploads/

# Large data dumps
*_dump.json
.gemini/

# Rapports & briefs d'audit (ponctuels, sensibles — garder en local)
AUDIT_*.md
src/audit-cyber
src/audit-infra
