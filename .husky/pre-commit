#!/bin/sh
# ═══════════════════════════════════════════════════════════════
# PRE-COMMIT HOOK — SigilOS
# Runs before each commit to catch issues early
# ═══════════════════════════════════════════════════════════════

echo ""
echo "🔐 ══════════════════════════════════════════════"
echo "   PRE-COMMIT CHECKS"
echo "═══════════════════════════════════════════════════"
echo ""

# ─────────────────────────────────────────────────────────────
# STAGE 1: SECRET DETECTION (instant, blocks immediately)
# ─────────────────────────────────────────────────────────────

echo "🔍 Scanning for secrets..."

# Discord tokens (Bot/User)
if git diff --cached --name-only | xargs grep -l -E "[MN][A-Za-z0-9]{23,}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27,}" 2>/dev/null; then
    echo "❌ Possible Discord token detected! Commit blocked."
    exit 1
fi

# .env files
if git diff --cached --name-only | grep -E "^\.env$"; then
    echo "❌ .env file detected in commit!"
    echo "   Use .env.example for documentation instead."
    exit 1
fi

# AWS / OpenAI keys
if git diff --cached --name-only | xargs grep -l -E "(AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{48})" 2>/dev/null; then
    echo "❌ Possible AWS/OpenAI key detected! Commit blocked."
    exit 1
fi

# GitHub tokens (PATs, OAuth)
if git diff --cached --name-only | xargs grep -l -E "(ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59})" 2>/dev/null; then
    echo "❌ Possible GitHub token detected! Commit blocked."
    exit 1
fi

# Database connection strings
if git diff --cached --name-only -- '*.ts' '*.tsx' '*.js' '*.jsx' | xargs grep -l -E "postgresql://[^\"]*@[^\"]*/" 2>/dev/null; then
    echo "❌ Possible database URL hardcoded! Use env variables instead."
    exit 1
fi

echo "✅ No secrets found"
echo ""

# ─────────────────────────────────────────────────────────────
# STAGE 2: LINT (only staged files, fast)
# ─────────────────────────────────────────────────────────────

echo "🧹 Linting staged files..."
npx lint-staged
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Lint errors found. Fix them before committing."
    exit 1
fi
echo ""

# ─────────────────────────────────────────────────────────────
# STAGE 3: TYPESCRIPT (whole project, ~5-15s)
# ─────────────────────────────────────────────────────────────

echo "🧪 TypeScript check..."
npx tsc --noEmit 2>&1
if [ $? -ne 0 ]; then
    echo ""
    echo "❌ TypeScript errors found. Fix them before committing."
    exit 1
fi

echo ""
echo "══════════════════════════════════════════════════"
echo "  ✅ ALL CHECKS PASSED — Commit allowed"
echo "══════════════════════════════════════════════════"
echo ""
