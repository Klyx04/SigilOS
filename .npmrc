# ─────────────────────────────────────────────────────────────
# SigilOS — npm Security Hardening
# Protection contre les attaques supply chain (Shai-Hulud etc.)
# ─────────────────────────────────────────────────────────────

# Legacy peer deps (existing config — needed for some packages)
legacy-peer-deps=true

# Pin exact versions — never auto-upgrade to a potentially
# compromised patch/minor version via ^ or ~ ranges
save-exact=true

# Always generate/respect the lockfile
package-lock=true

# Disable funding messages (noise reduction)
fund=false

# Reduce audit noise — only alert on high+ in dev
audit-level=high
