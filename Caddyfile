{
    email admin@sigilos.fr
}

(security_headers) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Referrer-Policy "strict-origin-when-cross-origin"
}

# ─── Rate-limit (F-14) — dernier rempart anti-DoS au niveau proxy ─────────────
# ⚠️ Borne HAUTE par IP + exemption des assets statiques. Ce n'est PAS une
# limitation fine du dashboard authentifié (la régulation par utilisateur est
# déjà faite dans l'app via Redis). Le rate-limit au proxy sert de filet de
# sécurité grossier, il ne doit JAMAIS bloquer la navigation légitime :
#  - assets statiques / monde (tuiles webp, worldmap.json, _next, uploads)
#    → EXEMPTS (un dashboard/monde chargé = centaines de requêtes en rafale).
#  - reste (pages, RSC, API) → limite haute 3000 req/min + burst 500 req/s/IP.
# Correctif 2026-08-10 : anciens seuils (300/min + burst 60/s) déclenchaient des
# 429 en pagaille sur le monde/tuiles et le prefetch RSC d'un utilisateur normal.
(rate_limit_base) {
    @rl_exempt not path /game-data/* /_next/* /manifest.webmanifest /images/* /icons/* /fonts/* /api/storage/*

    rate_limit @rl_exempt {
        zone public_ip {
            key {remote_host}
            events 3000
            window 1m
        }
        zone burst {
            key {remote_host}
            events 500
            window 1s
        }
    }
}

# =============================================================================
# 🔴 PRODUCTION — Page d'attente premium (pas encore lancée)
# =============================================================================
sigilos.fr {
    import security_headers
    import rate_limit_base

    @google path /google*.html
    handle @google {
        header Content-Type text/html
        respond "google-site-verification: google77dc76da1868d7bd.html" 200
    }

    handle /socket.io/* {
        reverse_proxy sigilos-ws-prod:3001
    }

    handle {
        root * /srv/static
        rewrite * /maintenance.html
        file_server
    }
}

# =============================================================================
# 🟡 BETA — Reverse proxy + toggle maintenance pendant les déploiements
# =============================================================================
# Pour activer la maintenance :  touch /srv/maintenance-beta-on
# Pour la désactiver :           rm /srv/maintenance-beta-on
# (Automatisé par deploy.sh)
# =============================================================================
beta.sigilos.fr {
    import security_headers
    import rate_limit_base

    # If maintenance flag file exists, serve the maintenance page
    @maintenance_on expression `file("/srv/maintenance-beta-on")`
    handle @maintenance_on {
        root * /srv/static
        rewrite * /maintenance-beta.html
        file_server
    }

    # Normal operation: proxy to Next.js
    handle /socket.io/* {
        reverse_proxy sigilos-ws-beta:3001 {
            header_up X-Real-IP {remote_host}
            header_up -X-Forwarded-For
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle {
        reverse_proxy sigilos-beta:3000 {
            header_up X-Real-IP {remote_host}
            header_up -X-Forwarded-For
            header_up X-Forwarded-For {remote_host}
        }
    }
}

# =============================================================================
# 📊 MONITORING
# =============================================================================
monitor.sigilos.fr {
    import security_headers
    import rate_limit_base
    reverse_proxy sigilos-grafana:3000
}