# Custom Caddy with rate-limit module (F-14)
# The official caddy:alpine image does NOT include the ratelimit plugin.
# Build: docker build -f Dockerfile.caddy -t sigilos-caddy:latest .
FROM caddy:2.11.8-builder-alpine AS builder

# ⚠️ Version PINNÉE (verrouillée par tests/unit/caddy-image-pin.test.ts).
# Mesure du 04/11/2026 : `caddy build-info` dans le conteneur répondait `go1.23.8`
# et `mod caddy (devel)` — le tag restait en 2.9.1 et `xcaddy build` sans version
# compilait `master`. Le proxy exposé à Internet tournait donc sur un binaire de
# janvier 2025, sans aucun correctif Go/Caddy depuis.
# Le module ratelimit est le SEUL laissé à `@latest` : son unique tag (v0.1.0) est
# plus ancien que `master`, le pinner serait une régression. S'il devient
# incompatible avec l'API de Caddy, `xcaddy build` échoue ici et `caddy validate`
# bloque la bascule — le proxy en service n'est jamais remplacé à l'aveugle.
RUN xcaddy build v2.11.8 --with github.com/mholt/caddy-ratelimit@latest

FROM caddy:2.11.8-alpine

COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# DS-0002 : exécuter en non-root (uid 1000). On utilise l'UID NUMÉRIQUE (1000:1000)
# et non le nom "caddy" : le user par nom n'est pas toujours résolu dans l'image
# runtime → évite l'erreur "unable to find user caddy: no matching entries in passwd".
USER 1000:1000

EXPOSE 80 443 443/udp
ENTRYPOINT ["caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]