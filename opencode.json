{
  "$schema": "https://opencode.ai/config.json",
  "skills": [".agents/skills"],
  "permissions": [
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*Set-Content*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*Out-File*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*Add-Content*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*>.env*", "effect": "deny" },
    { "action": "shell", "resource": "*> .env*", "effect": "deny" },
    { "action": "shell", "resource": "*Get-Content*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*cat *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*type *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*more *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*Select-String*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*grep*.env*", "effect": "deny" },
    { "action": "shell", "resource": "*head *.env*", "effect": "deny" },
    { "action": "shell", "resource": "*tail *.env*", "effect": "deny" },
    { "action": "edit", "resource": "*prisma/migrations/*", "effect": "ask" },
    { "action": "shell", "resource": "*prisma migrate dev*", "effect": "ask" },
    { "action": "shell", "resource": "*prisma db push*", "effect": "ask" },
    { "action": "shell", "resource": "*git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "*git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "*git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "*prisma migrate reset*", "effect": "ask" },
    { "action": "shell", "resource": "*drop database*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "ask" },
    { "action": "shell", "resource": "*Remove-Item*-Recurse*", "effect": "ask" },
    { "action": "shell", "resource": "*--no-verify*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" }
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      "coverage/**",
      "public/assets/**",
      "public/uploads/**",
      "private_uploads/**",
      "docs/audits/**",
      "src/temp/**",
      "*.log",
      "*.tmp",
      "tsconfig.tsbuildinfo"
    ]
  },
  "worktree": {
    "directory": "../sigilos-worktrees"
  },
  "mcp": {
    "servers": {
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      }
    }
  }
}
