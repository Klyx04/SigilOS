{
  "name": "temp-sigil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker": "npx -y tsx src/workers/metamob-worker.ts",
    "presence": "npx -y tsx src/workers/presence-worker.ts",
    "prepare": "husky",
    "seed": "npx -y tsx prisma/seed.ts",
    "seed:game-data": "npx -y tsx prisma/seed-data/seed.ts",
    "seed:game-data:prod": "node prisma/seed-data/seed.js",
    "build:seeds": "esbuild prisma/seed-data/seed.ts --bundle --platform=node --outfile=prisma/seed-data/seed.js --external:@prisma/client && esbuild prisma/seed.ts --bundle --platform=node --outfile=prisma/seed.js --external:@prisma/client",
    "build:maintenance": "esbuild scripts/database-janitor.ts --bundle --platform=node --outfile=scripts/database-janitor.js --external:@prisma/client",
    "build:worker": "esbuild src/workers/metamob-worker.ts --bundle --platform=node --outfile=dist/worker.js --external:@prisma/client --external:ioredis --external:bullmq",
    "build:presence": "esbuild src/workers/presence-worker.ts --bundle --platform=node --outfile=dist/presence-worker.js --external:@prisma/client --external:ioredis --external:discord.js",
    "seed:docs": "npx -y tsx prisma/seed-docs.ts",
    "export-seeds": "bash scripts/export-seeds.sh local"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.41.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-bubble-menu": "^3.20.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-typography": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "bullmq": "^5.70.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "emoji-mart": "5.6.0",
    "framer-motion": "^12.34.4",
    "ioredis": "^5.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.576.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.19.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "use-debounce": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet"
    ]
  }
}
