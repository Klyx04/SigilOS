    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "bullmq": "^5.81.5",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "emoji-mart": "5.6.0",
    "framer-motion": "^12.43.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.23.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "0.4.6",
    "nsfwjs": "^4.4.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "use-debounce": "^10.1.1",
    "uuid": "^11.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "1.64.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.0",
    "brace-expansion": "^5.0.8",
    "find-my-way": "^9.7.0",
    "valibot": "^1.4.2",
    "@hono/node-server": "^1.19.13",
    "undici": "^7.30.1",
    "ws": "^8.21.0",
    "hono": "^4.12.26",
    "form-data": "^4.0.6",
    "@babel/core": "^7.29.1",
    "vite": "^8.3.5",
    "sharp": "$sharp",
    "fast-uri": "^3.1.9",
    "nanoid": "^3.3.17",
    "dompurify": "^3.4.16",
    "mysql2": "^3.22.0",
    "source-map-js": "^1.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet"
    ]
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linuxmusl-x64": "1.3.4",
    "@img/sharp-linuxmusl-x64": "0.35.5"
  }
}
