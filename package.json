{
  "name": "temp-sigil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=5000",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker": "npx -y tsx src/workers/metamob-worker.ts",
    "ws": "npx -y tsx src/server/websocket/server.ts",
    "start:ws": "node ./ws-server.js",
    "prepare": "husky",
    "seed": "npx -y tsx prisma/seed.ts",
    "seed:game-data": "npx -y tsx prisma/seed-data/seed.ts",
    "seed:game-data:prod": "node prisma/seed-data/seed.js",
    "build:seeds": "esbuild prisma/seed-data/seed.ts --bundle --platform=node --outfile=prisma/seed-data/seed.js --external:@prisma/client && esbuild prisma/seed.ts --bundle --platform=node --outfile=prisma/seed.js --external:@prisma/client",
    "build:maintenance": "esbuild scripts/database-janitor.ts --bundle --platform=node --outfile=scripts/database-janitor.js --external:@prisma/client",
    "build:siphon": "esbuild scripts/siphon-guide-images.ts --bundle --platform=node --outfile=scripts/siphon-guide-images.js --external:@prisma/client --external:sharp",
    "build:worker": "esbuild src/workers/metamob-worker.ts --bundle --platform=node --outfile=dist/worker.js --external:@prisma/client --external:ioredis --external:bullmq",
    "build:ladder-sync": "esbuild src/workers/ladder-sync-worker.ts --bundle --platform=node --outfile=dist/ladder-sync.js --external:@prisma/client --external:ioredis --external:bullmq",
    "ladder:sync": "npx -y tsx src/workers/ladder-sync-worker.ts",
    "build:ws": "esbuild src/server/websocket/server.ts --bundle --platform=node --outfile=dist/ws-server.js --external:@prisma/client",
    "seed:docs": "npx -y tsx prisma/seed-docs.ts",
    "export-seeds": "bash scripts/export-seeds.sh local",
    "migrate:uploads": "node scripts/migrate-uploads.mjs"
  },
