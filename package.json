{
  "name": "temp-sigil",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=10000",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:audit": "node scripts/security-gate.mjs",
    "security:install-scripts": "node scripts/check-install-scripts.mjs",
    "worker": "npx -y tsx src/workers/metamob-worker.ts",
    "ws": "npx -y tsx src/server/websocket/server.ts",
    "start:ws": "node ./ws-server.js",
    "prepare": "husky",
    "install:safe": "npm ci --ignore-scripts && npm rebuild prisma \"@prisma/engines\" && npm run prepare",
    "seed": "npx -y tsx prisma/seed.ts",
    "seed:game-data": "npx -y tsx prisma/seed-data/seed.ts",
    "seed:game-data:prod": "node prisma/seed-data/seed.js",
    "succes:prod": "node scripts/succes-speciaux.js",
    "backfill:dungeon-completion:prod": "node scripts/backfill-dungeon-completion.js",
    "build:seeds": "esbuild prisma/seed-data/seed.ts --bundle --platform=node --outfile=prisma/seed-data/seed.js --external:@prisma/client --external:sharp && esbuild prisma/seed.ts --bundle --platform=node --outfile=prisma/seed.js --external:@prisma/client --external:sharp",
    "build:maintenance": "esbuild scripts/database-janitor.ts --bundle --platform=node --outfile=scripts/database-janitor.js --external:@prisma/client --external:sharp",
    "build:siphon": "esbuild scripts/siphon-guide-images.ts --bundle --platform=node --outfile=scripts/siphon-guide-images.js --external:@prisma/client --external:sharp",
    "build:succes": "esbuild scripts/succes-speciaux.ts --bundle --platform=node --outfile=scripts/succes-speciaux.js --alias:@=./src --external:@prisma/client --external:sharp",
    "build:backfill-dungeon-completion": "esbuild scripts/backfill-dungeon-completion.ts --bundle --platform=node --outfile=scripts/backfill-dungeon-completion.js --alias:@=./src --external:@prisma/client --external:sharp",
    "build:worker": "esbuild src/workers/metamob-worker.ts --bundle --platform=node --outfile=dist/worker.js --external:@prisma/client --external:ioredis --external:bullmq --external:sharp",
    "build:ladder-sync": "esbuild src/workers/ladder-sync-worker.ts --bundle --platform=node --outfile=dist/ladder-sync.js --external:@prisma/client --external:ioredis --external:bullmq --external:sharp",
    "ladder:sync": "npx -y tsx src/workers/ladder-sync-worker.ts",
    "build:ws": "esbuild src/server/websocket/server.ts --bundle --platform=node --outfile=dist/ws-server.js --external:@prisma/client --external:sharp",
    "build:oauth-migrate": "esbuild scripts/migrate-oauth-tokens.ts --bundle --platform=node --outfile=dist/migrate-oauth-tokens.js --external:@prisma/client --external:ioredis --external:bullmq --external:sharp",
    "export-seeds": "bash scripts/export-seeds.sh local",
    "migrate:uploads": "node scripts/migrate-uploads.mjs",
    "siphon:guild-missions": "python scripts/siphon-guild-missions.py"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.76.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tensorflow/tfjs": "^4.22.0",
