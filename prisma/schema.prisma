model UserSkin {
  id               String      @id @default(cuid())
  profileId        String
  name             String
  url              String
  provider         String
  thumbnailUrl     String?
  equipment        Json?
  colors           Json?
  metadata         Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  discordMessageId String?     @unique
  votes            SkinVote[]
  profile          UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([url])
  @@index([discordMessageId])
}

model SkinVote {
  id        String   @id @default(cuid())
  skinId    String
  userId    String
  guildId   String
  createdAt DateTime @default(now())
  skin      UserSkin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@unique([skinId, userId])
  @@index([skinId])
  @@index([guildId])
}

model GuildModules {
  id               String      @id @default(cuid())
  guildId          String      @unique
  songes           Boolean     @default(true)
  missions         Boolean     @default(true)
  ocre             Boolean     @default(true)
  calendar         Boolean     @default(true)
  ladder           Boolean     @default(true)
  docs             Boolean     @default(true)
  updatedAt        DateTime    @updatedAt
  updatedBy        String?
  donjons          Boolean     @default(true)
  logs             Boolean     @default(true)
  presentation     Boolean     @default(true)
  profile          Boolean     @default(true)
  roster           Boolean     @default(true)
  services         Boolean     @default(true)
  stats            Boolean     @default(true)
  polls            Boolean     @default(true)
  admin            Boolean     @default(true)
  quests           Boolean     @default(false)
  resources        Boolean     @default(false)
  worldmap         Boolean     @default(false)
  gallery          Boolean     @default(true)
  ladderSync       Boolean     @default(false)
  minigames        Boolean     @default(true)
  manualLadderSync Boolean     @default(true)
  availability     Boolean     @default(false)
  succes           Boolean     @default(false)
  reactionRoles    Boolean     @default(true)
  tickets          Boolean     @default(false)
  commandes       Boolean     @default(true)
  /** Module « Marché » — OFF par défaut pour les nouvelles guildes (D15). */
  marche          Boolean     @default(false)
  guild            GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  /**
   * Modules verrouillés par le staff (noms de ModuleKey). Un module verrouillé
   * est effectif OFF quelle que soit la bascule guilde (qui est conservée) ;
   * sa RBAC associée est masquée de la matrice (mappings conservés).
   */
  disabledByGod    String[]    @default([])
}

/**
 * Demande de récupération d'une guilde orpheline (zéro admin natif + zéro
 * délégué). Créée par le membre actif le plus ancien, approuvée par un God
 * via le transfert de propriété existant. Jamais d'auto-élévation.
 */
model GuildRecoveryClaim {
  id              String    @id @default(cuid())
  guildId         String
  claimantUserId  String
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedBy       String?

  @@index([guildId])
  @@index([status])
}

model AuditLog {
  id          String       @id @default(cuid())
  guildId     String?
  actorUserId String
  actorName   String
  action      String
  targetType  String
  targetId    String?
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  // true = action super-admin/God (ne doit PAS apparaître dans les logs d'une guilde)
  isGodLog    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  guild       GuildConfig? @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model GuildActivity {
  id         String      @id @default(cuid())
