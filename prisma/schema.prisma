generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                   String             @id @default(cuid())
  name                 String?
  email                String?            @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  deletionRequestedAt  DateTime?
  emailBackup          String?
  scheduledDeletion    DateTime?
  lastSeenChangelogId  String?
  lastFeedViewedAt     DateTime?          @default(now())
  accounts             Account[]
  dreamJoinRequests    DreamJoinRequest[]
  dreamRuns            DreamRun[]         @relation("RunLeader")
  dreamRunMembers      DreamRunMember[]
  dreamWaitlists       DreamWaitlist[]
  eventParticipations  EventParticipant[]

  guildEvents          GuildEvent[]
  notifications        Notification[]
  administeredRelances Relance[]          @relation("RelanceAdmin")
  sessions             Session[]
  profiles             UserProfile[]
}

model AllowedGuild {
  id             String    @id @default(cuid())
  discordGuildId String    @unique
  name           String?
  tier           String    @default("BETA")
  isActive       Boolean   @default(true)
  addedBy        String
  addedAt        DateTime  @default(now())
  expiresAt      DateTime?
  notes          String?

  @@index([discordGuildId])
  @@index([isActive])
}

model PlatformBan {
  id         String   @id @default(cuid())
  entityType String
  discordId  String   @unique
  reason     String
  bannedBy   String
  createdAt  DateTime @default(now())

  @@index([discordId])
  @@index([entityType])
}

model BlacklistEntry {
  id               String      @id @default(cuid())
  guildId          String
  content          String
  addedById        String
  addedByName      String
  createdAt        DateTime    @default(now())
  discordMessageId String?     @unique
  updatedAt        DateTime    @default(now()) @updatedAt
  guild            GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([createdAt])
  @@index([discordMessageId])
}

model PlatformConfig {
  id                     String   @id @default("singleton")
  hubChannelId           String?
  updatedAt              DateTime @updatedAt
  serviceStatusChannelId String?
  ticketAutoRoleId       String?
  ticketSupportGuildId   String?
  roadmapEnabled         Boolean  @default(false)
  statusIsLite           Boolean  @default(false)
  statusMode             String   @default("living")
  statusFrequency        Int      @default(15)
  statusMention          String   @default("none")
  nsfwFilterEnabled      Boolean  @default(true)
  geoguesserBlacklist    Int[]    @default([])
  godNotifyChannelId     String?
  godNotifyRoleId        String?
  godNotifyWebEnabled    Boolean  @default(true)
  geoguesserReportedMaps Int[]    @default([])
  donationsEnabled       Boolean  @default(true)
  maintenanceMode        Boolean  @default(false)
  maintenanceMessage     String?
}

model GodNotification {
  id        String        @id @default(cuid())
  title     String
  message   String
  type      GodNotifyType
  success   Boolean       @default(true)
  metadata  Json?
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model RoadmapItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("TODO")
  quarter     String
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([quarter])
}

model MiniGameStatus {
  id             String   @id @default(cuid())
  gameId         String   @unique
  isEnabled      Boolean  @default(true)
  maintenanceMsg String?  @default("🔧 Ce jeu est temporairement indisponible pour maintenance.")
  updatedAt      DateTime @updatedAt
}

model GuildConfig {
  id                               String                  @id @default(cuid())
  discordGuildId                   String                  @unique
  name                             String
  iconUrl                          String?
  isActive                         Boolean                 @default(true)
  rolesMapping                     Json                    @default("{}")
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  absenceChannelId                 String?
  calendarNotifyChannelId          String?
  raidNotifyChannelId              String?
  raidGigalodonNotifyChannelId     String?
  raidSanctuaireNotifyChannelId    String?
  userRequestChannelId             String?
  dofusServerId                    String?
  dofusServerName                  String?
  presentationActivities           Json?
  presentationBannerType           String?                 @default("discord")
  presentationBannerUrl            String?
  presentationCoLeaders            Json?
  presentationDiscord              String?
  presentationDiscordReq           Boolean                 @default(false)
  presentationEnabled              Boolean                 @default(false)
  presentationFoundedDate          DateTime?
  presentationFounder              String?
  presentationHistory              String?
  presentationMinLevel             Int?
  presentationMinSuccesses         Int?
  presentationPhotoUrl             String?
  presentationRecruitReq           String?
  presentationRecruiting           Boolean                 @default(false)
  presentationServer               String?
  presentationTeam                 Json?
  songesNotifyChannelId            String?
  missionRanks                     Json?
  missionTier                      Int?                    @default(3)
  bonusNotifyChannelId             String?
  deletedAt                        DateTime?
  deletionReason                   String?
  scheduledDeletion                DateTime?
  maxMembers                       Int                     @default(350)
  ownerId                          String?
  missionNotifyChannelId           String?
  missionNotifyRoleId              String?
  missionDiscordMessageId          String?
  pollsNotifyChannelId             String?
  pollsNotifyRoleId                String?
  ocreNotifyChannelId              String?
  djNotifyChannelId                String?
  servicesNotifyChannelId          String?
  loansNotifyChannelId             String?
  systemNotifyChannelId            String?
  lifecycleNotifyChannelId         String?
  welcomeEnabled                   Boolean                 @default(false)
  welcomeNotifyChannelId           String?
  welcomeDashboardEnabled          Boolean                 @default(true)
  welcomeDiscordEnabled            Boolean                 @default(false)
  welcomeMessageTemplate           String?
  welcomeMentionRoleId             String?
  missionValidationChannelId       String?
  missionValidationNotifyRoleId    String?
  welcomeBadgeName                 String                  @default("Nouveau")
  welcomeDiscordMessageTemplate    String?
  missionWeekXpOverride            Int?
  missionVitrineMode               Boolean                 @default(false)
  kamaNotifyChannelId              String?
  achievementNotifyChannelId       String?
  achievementNotifyRoleId          String?
  kamaNotifyRoleId                 String?
  usersMapping                     Json                    @default("{}")
  serviceLoansEnabled              Boolean                 @default(true)
  serviceLoansMessage              String?
  serviceMarketplaceEnabled        Boolean                 @default(true)
  serviceMarketplaceMessage        String?
  serviceVaultEnabled              Boolean                 @default(true)
  serviceVaultMessage              String?
  missionManagementNotifyChannelId String?
  missionManagementNotifyRoleId    String?
  newsBroadcastEnabled             Boolean                 @default(false)
  guildHallPosX                    Int?
  guildHallPosY                    Int?
  guildHallWorldId                 Int?                    @default(1)
  guildatonAdminChannelId          String?
  guildatonNotifyChannelId         String?
  guildatonReminderDay             Int?                    @default(0)
  guildatonReminderTime            String?                 @default("18:00")
  guildatonTrackedRoles            String[]                @default([])
  guildatonWeeklyQuota             Int                     @default(0)
  blacklistChannelId               String?
  skinGalleryChannelId             String?
  stuffGalleryChannelId            String?
  achievementSubmissions           AchievementSubmission[]
  auditLogs                        AuditLog[]
  blacklistEntries                 BlacklistEntry[]
  contentCreators                  ContentCreator[]
  djSearchPosts                    DjSearchPost[]

  guildActivities                  GuildActivity[]
  guildBonuses                     GuildBonus[]
  guildEvents                      GuildEvent[]
  guildLoans                       GuildLoan[]
  modules                          GuildModules?
  guildatonHistories               GuildatonHistory[]
  guildatonRecords                 GuildatonRecord[]
  kamaDonations                    KamaDonation[]
  welcomePosts                     MemberWelcome[]
  missions                         Mission[]
  ocreTradeRequests                OcreTradeRequest[]
  polls                            Poll[]
  relances                         Relance[]
  resourceCategories               ResourceCategory[]
  serviceActivityLogs              ServiceActivityLog[]
  serviceListings                  ServiceListing[]
  sigilRoles                       SigilRole[]
  profiles                         UserProfile[]
  vaultEntries                     VaultEntry[]
  allowedPingRoleIds               String[]                @default([])
  calendarPingRoleIds              String[]                @default([])
  raidPingRoleIds                  String[]                @default([])
  djPingRoleIds                    String[]                @default([])
  songesPingRoleIds                String[]                @default([])
  pollsPingRoleIds                 String[]                @default([])
  raidHubConfig                    Json?
}

model UserSkin {
  id               String      @id @default(cuid())
  profileId        String
  name             String
  url              String
  provider         String
  thumbnailUrl     String?
  equipment        Json?
  colors           Json?
  metadata         Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  discordMessageId String?     @unique
  votes            SkinVote[]
  profile          UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([url])
  @@index([discordMessageId])
}

model SkinVote {
  id        String   @id @default(cuid())
  skinId    String
  userId    String
  guildId   String
  createdAt DateTime @default(now())
  skin      UserSkin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@unique([skinId, userId])
  @@index([skinId])
  @@index([guildId])
}

model GuildModules {
  id               String      @id @default(cuid())
  guildId          String      @unique
  songes           Boolean     @default(true)
  missions         Boolean     @default(true)
  ocre             Boolean     @default(true)
  calendar         Boolean     @default(true)
  ladder           Boolean     @default(true)
  docs             Boolean     @default(true)
  updatedAt        DateTime    @updatedAt
  updatedBy        String?
  donjons          Boolean     @default(true)
  logs             Boolean     @default(true)
  presentation     Boolean     @default(true)
  profile          Boolean     @default(true)
  roster           Boolean     @default(true)
  services         Boolean     @default(true)
  stats            Boolean     @default(true)
  polls            Boolean     @default(true)
  admin            Boolean     @default(true)
  quests           Boolean     @default(false)
  resources        Boolean     @default(false)
  worldmap         Boolean     @default(false)
  gallery          Boolean     @default(true)
  ladderSync       Boolean     @default(false)
  minigames        Boolean     @default(true)
  manualLadderSync Boolean     @default(true)
  guild            GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String      @id @default(cuid())
  guildId     String
  actorUserId String
  actorName   String
  action      String
  targetType  String
  targetId    String?
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  createdAt   DateTime    @default(now())
  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model GuildActivity {
  id         String      @id @default(cuid())
  guildId    String
  type       String
  actorName  String
  actorImage String?
  meta       Json?
  createdAt  DateTime    @default(now())
  guild      GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

model UserProfile {
  id                         String                     @id @default(cuid())
  userId                     String
  guildId                    String
  status                     ProfileStatus              @default(ACTIVE)
  pseudoDofus                String?
  classe                     String?
  metiers                    Json?
  succes                     Json?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  achievementLastSync        DateTime?
  achievementPoints          Int?
  altPseudos                 Json?
  archiveReason              String?
  archivedAt                 DateTime?
  availability               Json?
  classeSecondaires          Json?
  discordCacheUpdatedAt      DateTime?
  discordJoinedAt            DateTime?
  discordNickname            String?
  discordRoleColor           Int?
  discordRoleName            String?
  dofusBookLinks             Json?
  dofusPseudo                String?
  entraidePoints             Int                        @default(0)
  fmPriceClassic             Int?
  fmPriceExo                 Int?
  fmPriceTrans               Int?
  forgemagieStatus           String?                    @default("UNAVAILABLE")
  guildatons                 Int                        @default(0)
  lastActivityAt             DateTime?
  lastActivityDesc           String?
  lastLadderUpdate           DateTime?
  metamobLastSync            DateTime?
  metamobPseudo              String?
  metamobVerified            Boolean                    @default(false)
  successPoints              Int?                       @default(0)
  vacationEnd                DateTime?
  vacationNotify             Boolean                    @default(false)
  vacationStart              DateTime?
  vacationReason             String?
  xp                         Int                        @default(0)
  metamobQuestSlug           String?
  metamobServerId            Int?
  metamobApiKey              String?
  contributionPoints         Int                        @default(0)
  scheduledDeletion          DateTime?
  notificationPrefs          Json?
  hasSeenWelcome             Boolean                    @default(false)
  introduction               String?
  isInGame                   Boolean                    @default(false)
  lastSeen                   DateTime?                  @default(now())
  showPresence               Boolean                    @default(true)
  ocreProgressSnapshot       Json?
  dofusLevel                 Int?                       @default(0)
  totalXp                    BigInt?                    @default(0)
  alignment                  String?
  alignmentOrder             String?
  alignmentLevel             Int?                       @default(0)
  ankamaId                   String?
  discordMessageCountWeekly  Int                        @default(0)
  discordVoiceTimeWeekly     Int                        @default(0)
  lastDiscordMessageAt       DateTime?
  lastDiscordReactionAt      DateTime?
  lastDiscordTypingAt        DateTime?
  lastDiscordVoiceAt         DateTime?
  discordMessageCountMonthly Int                        @default(0)
  discordMessageCountTotal   Int                        @default(0)
  discordVoiceTimeMonthly    Int                        @default(0)
  discordVoiceTimeTotal      Int                        @default(0)
  // Advanced Discord tracking
  discordCharactersWeekly    Int                        @default(0)
  discordCharactersMonthly   Int                        @default(0)
  discordCharactersTotal      Int                        @default(0)
  discordReactionsReceivedWeekly Int                    @default(0)
  discordReactionsReceivedMonthly Int                   @default(0)
  discordReactionsReceivedTotal Int                     @default(0)
  discordVoiceStreamTimeWeekly Int                      @default(0)
  discordVoiceStreamTimeMonthly Int                     @default(0)
  discordVoiceStreamTimeTotal  Int                        @default(0)
  discordRepliesWeekly       Int                        @default(0)
  discordRepliesMonthly      Int                        @default(0)
  discordRepliesTotal        Int                        @default(0)
  archiveDuration            Int?
  reactivationRequestReason  String?
  reactivationRequestedAt    DateTime?
  hiddenNavItems             String[]                   @default([])
  pinnedNavItems             String[]                   @default([])
  lastGalleryShareAt         DateTime?
  achievementSubmissions     AchievementSubmission[]
  djParticipations           DjSearchParticipant[]
  djSearchPosts              DjSearchPost[]
  guildBonuses               GuildBonus[]
  loansReceived              GuildLoan[]                @relation("LoansReceived")
  loansGiven                 GuildLoan[]                @relation("LoansGiven")
  givenCredits               HelpCredit[]               @relation("GivenCredits")
  receivedCredits            HelpCredit[]               @relation("ReceivedCredits")
  kamaDonations              KamaDonation[]
  welcomePosts               MemberWelcome[]
  interests                  MissionInterest[]
  sentOcreRequests           OcreTradeRequest[]         @relation("Requester")
  receivedOcreRequests       OcreTradeRequest[]         @relation("Target")
  dofusProgress              PlayerDofusProgress[]
  dofusQuestProgress         PlayerDofusQuestProgress[]
  polls                      Poll[]                     @relation("PollCreator")
  pollVotes                  PollVote[]
  serviceActivityLogs        ServiceActivityLog[]
  serviceListings            ServiceListing[]
  roleGrants                 SigilRoleGrant[]
  submissions                Submission[]
  userDungeonAchievements    UserDungeonAchievement[]
  dungeonProgress            UserDungeonProgress[]
  legendaryCrafts            LegendaryItem[]            @relation("LegendaryCrafters")
  hasLegendaryPrerequisites  Boolean                    @default(false)
  hasLegendaryPet            Boolean                    @default(false)
  playerGuideProgress        PlayerGuideProgress[]
  guild                      GuildConfig                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skins                      UserSkin[]
  vaultEntries               VaultEntry[]
  helpedSubmissions          Submission[]               @relation("SubmissionHelpers")

  @@unique([userId, guildId])
  @@index([guildId])
  @@index([userId])
}

model LegendaryItem {
  id          String   @id @default(cuid())
  name        String   @unique
  level       Int      @default(200)
  category    String   // Chapeau, Cape, Bouclier, etc.
  jobRequired String   // Tailleur, Bijoutier, Forgeur, Cordonnier, Façonneur
  passiveName String?
  passiveDesc String?
  effects     Json?    // Liste des stats (Force, Intel, etc.)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crafters    UserProfile[] @relation("LegendaryCrafters")
}

model Mission {
  id               String            @id @default(cuid())
  guildId          String
  category         MissionCategory
  status           MissionStatus     @default(ACTIVE)
  tier             Int               @default(1)
  xpReward         Int?
  guildatonsReward Int?
  title            String?
  payload          Json
  weekNumber       Int
  year             Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  slotIndex        Int               @default(0)
  rank             Int               @default(1)
  guild            GuildConfig       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  interests        MissionInterest[]
  submissions      Submission[]

  @@unique([guildId, weekNumber, year, slotIndex])
  @@index([guildId, weekNumber, year])
}

model MissionInterest {
  id        String      @id @default(cuid())
  missionId String
  profileId String
  createdAt DateTime    @default(now())
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([missionId, profileId])
  @@index([profileId])
}

model Submission {
  id               String           @id @default(cuid())
  missionId        String
  profileId        String
  status           SubmissionStatus @default(PENDING)
  proofUrl         String
  validatorId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ocrResult        Json?
  ocrScore         Float?
  ocrStatus        OcrStatus        @default(PENDING)
  discordMessageId String?
  mission          Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  helpers          UserProfile[]    @relation("SubmissionHelpers")

  @@unique([missionId, profileId])
  @@index([missionId])
  @@index([profileId])
  @@index([status, updatedAt])
}

model AchievementSubmission {
  id               String           @id @default(cuid())
  profileId        String
  guildId          String
  status           SubmissionStatus @default(PENDING)
  points           Int
  proofUrl         String
  ocrScore         Float?
  ocrRawText       String?
  validatorId      String?
  validatedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  discordMessageId String?
  guild            GuildConfig      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile          UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([profileId])
}

model Dungeon {
  id                   String                @id @default(cuid())
  name                 String
  bossName             String
  level                Int
  dpnlUrl              String?
  dofuspourlesnoobsUrl String?
  dofensiveUrl         String?
  imageUrl             String?
  createdAt            DateTime              @default(now())
  expeditionMechanics  String?
  expeditionModes      Json?
  isExpedition         Boolean               @default(false)
  updatedAt            DateTime              @updatedAt
  isEventDungeon       Boolean               @default(false)
  dofusdbId            Int?                  // Identifiant DofusDB pour croisement avec les données du jeu
  djSearchPosts        DjSearchPost[]
  achievements         DungeonAchievement[]
  userProgress         UserDungeonProgress[]
  zones                Zone[]                @relation("DungeonToZone")
  milestoneSequences   GuideSequence[]       // Donjons référencés dans les séquences du guide

  @@unique([name, bossName])
  @@index([level])
  @@index([isExpedition])
  @@index([isEventDungeon])
  @@index([dofusdbId])
}

model Zone {
  id           String          @id @default(cuid())
  name         String          @unique
  level        Int
  dpnlUrl      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  eventZoneKey String?
  isEventZone  Boolean         @default(false)
  dungeons     Dungeon[]       @relation("DungeonToZone")
  families     MonsterFamily[] @relation("MonsterFamilyToZone")

  @@index([name])
  @@index([isEventZone])
}

model Bounty {
  id         String   @id @default(cuid())
  name       String   @unique
  level      Int
  zoneName   String?
  imageUrl   String?
  reward     String?
  levelMin   Int?
  levelMax   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dpnlUrl    String?
  doplons    Int      @default(0)
  mechanics  String?
  milice     String?
  rewardType String   @default("Doplon")
  mapUrl     String?
  rewards    Json?    @default("[]")
  position   String?

  @@index([name])
  @@index([zoneName])
}

model Monster {
  id        String        @id @default(cuid())
  name      String
  imageUrl  String?
  createdAt DateTime      @default(now())
  familyId  String
  level     Int?
  updatedAt DateTime      @updatedAt
  family    MonsterFamily @relation(fields: [familyId], references: [id])

  @@index([familyId])
  @@index([name])
}

model MonsterFamily {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  level       Int?
  monsters    Monster[]
  zones       Zone[]    @relation("MonsterFamilyToZone")

  @@index([name])
}

model Challenge {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  description         String?
  iconUrl             String?
  conditions          Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dungeonAchievements DungeonAchievement[]

  @@index([slug])
  @@index([name])
}

model DungeonAchievement {
  id           String                   @id @default(cuid())
  dungeonId    String
  challengeId  String
  points       Int                      @default(10)
  imageUrl     String?
  createdAt    DateTime                 @default(now())
  challenge    Challenge                @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dungeon      Dungeon                  @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  achievedBy   UserDungeonAchievement[]
  userProgress UserDungeonProgress[]

  @@unique([dungeonId, challengeId])
  @@index([dungeonId])
  @@index([challengeId])
}

model UserDungeonAchievement {
  id                   String             @id @default(cuid())
  userId               String
  dungeonAchievementId String
  completedAt          DateTime           @default(now())
  dungeonAchievement   DungeonAchievement @relation(fields: [dungeonAchievementId], references: [id], onDelete: Cascade)
  user                 UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dungeonAchievementId])
  @@index([userId])
  @@index([dungeonAchievementId])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean              @default(false)
  link      String?
  createdAt DateTime             @default(now())
  category  NotificationCategory @default(SYSTEM)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([userId, read, createdAt])
}

model DreamRun {
  id                  String             @id @default(cuid())
  guildId             String
  leaderId            String
  difficulty          DreamDifficulty
  objective           DreamObjective?    @default(FUN)
  objectives          DreamObjective[]
