  isEnabled               Boolean             @default(false)
  activatedAt             DateTime?
  activatedBy             String?
  logChannelId            String?
  transcriptsChannelId    String?
  staffRoleIds            String[]            @default([])
  maxActiveTicketsPerUser Int                 @default(1)
  maxTicketsTotalGuild    Int                 @default(50)
  enableCsat              Boolean             @default(true)
  enableDmNotifications   Boolean             @default(true)
  enableTranscripts       Boolean             @default(true)
  /// 🆕 v2 — rétention par type de donnée, en jours (0 = illimité). Consommée par
  /// la purge (`src/server/tickets/archive.ts`), jamais affichée sans mécanisme.
  transcriptRetentionDays Int                 @default(365)
  noteRetentionDays       Int                 @default(365)
  auditRetentionDays      Int                 @default(730)
  settingsJson            Json?               @default("{}")
  createdAt               DateTime            @default(now())
