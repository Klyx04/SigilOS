/// 📦 #38 — Catalogue complet d'items et ressources Dofus 3 (100% autonome et local-first).
model GameItem {
  id           String   @id @default(cuid())
  ankamaId     Int      @unique
  name         String
  level        Int      @default(1)
  typeId       Int?
  typeName     String   @default("Item")
  category     String   @default("equipment") // equipment | resources | consumables | cosmetics
  description  String?  @db.Text
  effects      Json?    // Array d'effets min/max avec caractéristique
  recipe       Json?    // Array d'ingrédients [{ id, name, qty, iconUrl }]
  hasRecipe    Boolean  @default(false)
  iconUrl      String?
  dataHash     String?  // MD5 des stats/recette pour détection différentielle (nerf/buff/modifs)
  isDeprecated Boolean  @default(false)
  // ── S2 (chantier Marché) — extension ADDITIVE issue de DofusDB (§6.11) ────
  realWeight    Int?      // POIDS (pods)
  priceNpc      Int?      // `price` DofusDB → prix PNJ de référence
  itemSetId     Int?      // panoplie (-1 = aucune)
  itemSetName   String?   // « Panoplie du Katcheur »
  isLegendary   Boolean   @default(false)   // familiers / objets légendaires
  isSaleable    Boolean   @default(true)
  superTypeId   Int?      // famille (Arme, Consommable, Ressource…)
  superTypeName String?   // libellé FR de la famille
  // Version LÉGÈRE des effets natifs (plages min–max) — indispensable à l'éditeur FM
  // et à la carte d'item : [{ effectId, characteristic, from, to, category, elementId }]
  nativeEffects Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([typeName])
  @@index([level])
  @@index([itemSetId])      // filtre « panoplie » (éditeur FM)
  @@index([superTypeId])    // filtre « famille » (éditeur FM)
}

/// 📚 Référentiel DofusDB `/effects` — siphonné (S2.5bis).
/// Rend les libellés FR, le « % » et la caractéristique **data-driven** :
/// `CHAR_NAMES` (codé en dur côté composant) est remplacé par cette table.
model GameEffect {
  id             Int      @id                  // = effectId DofusDB
  name           String                        // libellé FR (« Vitalité », « Dommages Feu »)
  characteristic Int?                          // caractéristique associée (→ GameCharacteristic.id)
  isInPercent    Boolean  @default(false)      // l'effet s'exprime en % (résistances…)
  category       Int?                          // catégorie DofusDB (utile au tri d'affichage)
  iconKey        String?                       // slug d'icône locale (`vi`, `fo`, `dmg`, `po`…)
  // ── Fidélité DofusDB (correction 13/09) — sens de la ligne ───────────────
  // DofusDB expose `characteristicOperator` (« + » / « - ») et un gabarit de
  // description qui **porte le signe** (« -#1{{~1~2 à -}}#2 Esquive PA »).
  // Les dés bruts d'un item (`possibleEffects`) sont TOUJOURS positifs : sans
  // ces drapeaux, un malus s'affiche « +6 à +8 » (constat user du 13/09).
  characteristicOperator String?               // « + » | « - » (source DofusDB)
  isNegativeValue        Boolean @default(false) // la ligne s'AFFICHE négative (ex. Esquive PA)
  updatedAt      DateTime @updatedAt

  @@index([characteristic])
}

/// 📚 Référentiel DofusDB `/characteristics` — siphonné (S2.5bis).
/// Alimente l'icône + la couleur d'une caractéristique **data-driven**
/// (remplace `STAT_ICONS` codé en dur côté composant).
model GameCharacteristic {
  id        Int      @id                       // = characteristicId DofusDB
  name      String                             // libellé FR (« Vitalité », « Force »…)
  keyword   String?                            // code court historique (`vi`, `fo`, `dmg`…)
  iconKey   String?                            // slug d'icône locale (public/assets/dofus/stats)
  updatedAt DateTime @updatedAt

  @@index([keyword])
}

/// 📖 Cache persistant des sorts de classes (19 lignes max, une par classe).
/// Remplace le seul cache Redis 24 h de `getClassSpells` : les sorts (tous grades
/// + lignes de dégâts `zoneDescr`) survivent au restart/expire Redis. Le grade
/// par défaut reste sélectionné à la LECTURE selon le niveau du perso
/// (`applyCharLevelToSpells`) : une seule ligne par classe suffit.
model ClassSpellbook {
  classId    Int      @id                       // 1-19 (ordre Dofusbook)
  className  String                             // « Huppermage »
  spells     Json                               // ClassSpellDamage[] canonique (grade niv. 200 + tous grades)
  spellCount Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ServiceListing {
  id                       String          @id @default(cuid())
  guildId                  String
  profileId                String
  category                 ServiceCategory
