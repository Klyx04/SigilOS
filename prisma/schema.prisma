model DjSearchPost {
  id                   String                @id @default(cuid())
  guildId              String
  profileId            String
  dungeonId            String?
  mode                 DjSearchMode          @default(DONJON)
  wantedAchievementIds String[]
  maxMembers           Int                   @default(4)
  questName            String?
  questUrl             String?
  message              String?
  targetDate           DateTime?
  status               DjSearchStatus        @default(OPEN)
  discordMessageId     String?
  discordChannelId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  closedAt             DateTime?
  expiresAt            DateTime
  lastReminderAt       DateTime?
  isDiscordPublished   Boolean               @default(false)
  questId              Int?
  requiredClasses      String[]
  mentionRoleId        String?
  /**
   * Mode multi-donjons (#26) : UN SEUL post portant N donjons (2-5).
   * Chaque entrée contient le snapshot du donjon (nom/image/niveau/succès)
   * + succès visés + note + date prévue. dungeonId reste NULL en mode multi.
   */
  dungeonsJson         Json?
  participants         DjSearchParticipant[]
  dungeon              Dungeon?              @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  /* Mode Défi (# — chantier double boss/défi) : post rattaché à un défi (simple ou multi). */
  defiId               String?
  defiName             String?
  defi                 Defi?                 @relation(fields: [defiId], references: [id], onDelete: Cascade)
  /* Mode Titan (# — Événement Krosmique) : post rattaché à un titan (ex. Gargandyas). */
  titanId              String?
  titanName            String?
  titan                Titan?                @relation(fields: [titanId], references: [id], onDelete: Cascade)
  guild                GuildConfig           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile              UserProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([profileId])
  @@index([dungeonId])
  @@index([expiresAt])
}

