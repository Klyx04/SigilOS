/// 🆕 v2 — équipe répondante réutilisable (rôles Discord staff + rôles à notifier).
model TicketTeam {
  id            String          @id @default(cuid())
  guildId       String
  name          String
  slug          String
  description   String?
  /// Rôles Discord considérés comme **staff de cette équipe** (voient et traitent).
  staffRoleIds  String[]        @default([])
  /// Rôles mentionnés à l'ouverture. Vide par défaut : jamais `@everyone` implicitement.
  notifyRoleIds String[]        @default([])
  isEnabled     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  guild         GuildConfig     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  journeys      TicketJourney[]

  @@unique([guildId, slug])
  @@index([guildId, isEnabled])
}

/// 🆕 v2 — formulaire réutilisable. Le brouillon est éditable ; publier crée une
/// `TicketFormVersion` **figée** que les tickets référencent ⇒ une réponse reste
/// relisible même si la question est renommée plus tard.
model TicketForm {
  id               String             @id @default(cuid())
  guildId          String
  name             String
  slug             String
  description      String?
  status           TicketFormStatus   @default(DRAFT)
  /// Version courante (incrémentée à chaque publication).
  currentVersion   Int                @default(0)
  /// Version publiée (null = jamais publié ⇒ aucun parcours ne peut la référencer).
  publishedVersion Int?
  /// Brouillon éditable — validé par `parseFormSchema` (`src/lib/tickets/form-schema.ts`).
  draftSchemaJson  Json               @default("[]")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  guild            GuildConfig        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  versions         TicketFormVersion[]
  journeys         TicketJourney[]

  @@unique([guildId, slug])
  @@index([guildId, status])
}

/// 🆕 v2 — version **figée** d'un formulaire (jamais modifiée après publication).
model TicketFormVersion {
  id            String      @id @default(cuid())
  formId        String
  guildId       String
  version       Int
  schemaJson    Json
  publishedById String?
  createdAt     DateTime    @default(now())

  guild         GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  form          TicketForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  tickets       TicketRecord[]

  @@unique([formId, version])
  @@index([guildId])
  @@index([formId, createdAt])
}

/// 🆕 v2 — brouillon d'ouverture : les réponses déjà données avant la création du ticket
/// (étape « choix » Oui/Non & sélecteurs, puis modale des textes). TTL court, supprimé
/// à la création réussie ou par la purge — jamais affiché comme un ticket.
model TicketDraft {
  id            String        @id @default(cuid())
  guildId       String
  journeyId     String
  formVersionId String?
  discordUserId String
  /// Réponses déjà collectées, clés par `id` de champ (jamais par libellé).
  answersJson   Json          @default("{}")
  /// `CHOICES` = en attente de choix ; `TEXTS` = en attente de la modale.
  step          String        @default("CHOICES")
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  guild         GuildConfig   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  journey       TicketJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([guildId, journeyId, discordUserId])
  @@index([guildId, expiresAt])
}

/// 🆕 v2 — **le parcours** : l'unité éditable que comprend le chef de guilde
/// (« Candidature », « Contacter le staff », « Signaler »). Il remplace la catégorie
/// v1 (`TicketBotCategory`, conservée en lecture pour les tickets déjà ouverts).
model TicketJourney {
  id              String            @id @default(cuid())
  guildId         String
  name            String
  slug            String
  description     String?
  emoji           String            @default("🎫")
  buttonStyle     TicketButtonStyle @default(PRIMARY)
  channelType     TicketChannelType @default(CHANNEL_TEXT)
  channelParentId String?
  /// Rôles staff **du parcours** (s'ajoutent à ceux de l'équipe et de la config guilde).
  staffRoleIds    String[]          @default([])
  teamId          String?
  formId          String?
  /// Version du formulaire **figée** à la publication (les réponses sont relues avec).
  formVersion     Int?
  namingPattern   String            @default("ticket-{num}")
  openMode        TicketOpenMode    @default(INSTANT)
  closePolicy     TicketClosePolicy @default(STAFF_ONLY)
  order           Int               @default(0)
  isEnabled       Boolean           @default(true)
  isPublished     Boolean           @default(false)
  publishedAt     DateTime?
  publishedVersion Int              @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  guild           GuildConfig       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  team            TicketTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  form            TicketForm?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  tickets         TicketRecord[]
  drafts          TicketDraft[]

  @@unique([guildId, slug])
  @@index([guildId, isEnabled, order])
  @@index([guildId, isPublished])
}

model TicketRecord {
  id                   String            @id @default(cuid())
  ticketNumber         Int               @default(autoincrement())
  guildId              String
  /// ⚠️ v1 — catégorie d'origine. `null` pour un ticket v2 ouvert via un parcours.
  categoryId           String?
  /// 🆕 v2 — parcours d'origine (`null` pour un ticket v1).
  journeyId            String?
  /// 🆕 v2 — version de formulaire **figée** à l'ouverture : les réponses restent
  /// relisibles et validables même si le formulaire change ensuite.
  formVersionId        String?
  discordGuildId       String
  discordChannelId     String?           @unique
  discordThreadId      String?           @unique
  creatorDiscordId     String
  creatorDiscordName   String
  creatorAvatarUrl     String?
  creatorProfileId     String?
  status               TicketBotStatus   @default(OPEN)
  /// 🆕 v2 — file d'approbation (`REQUESTED` → `OPEN` ou `REFUSED`), avant tout salon.
  approvedByDiscordId  String?
  approvedAt           DateTime?
  refusedByDiscordId   String?
  refusedAt            DateTime?
  refusalReason        String?
  claimedByDiscordId   String?
  claimedByName        String?
  claimedAt            DateTime?
  firstStaffResponseAt DateTime?
  slaResponseBreached  Boolean           @default(false)
  slaResolveBreached   Boolean           @default(false)
  lastActivityAt       DateTime          @default(now())
  warningSentAt        DateTime?
  closedAt             DateTime?
  closedByDiscordId    String?
  closedByName         String?
  closedReason         String?
  /// 🆕 v2 — étiquettes libres (bornées côté service) et priorité (0 normale, 2 urgente).
  tags                 String[]          @default([])
  priority             Int               @default(0)
  intakeAnswersJson    Json?             @default("{}")
  metadataJson         Json?             @default("{}")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  guild                GuildConfig       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  category             TicketBotCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  journey              TicketJourney?    @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  formVersion          TicketFormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  notes                TicketNote[]
  /// 🆕 v2 — jusqu'à deux archives : `SHAREABLE` (sans notes) et `INTERNAL` (annexe staff).
  transcripts          TicketTranscript[]
  feedback             TicketFeedback?
  auditLogs            TicketAuditLog[]

  @@index([guildId, status])
  @@index([guildId, categoryId])
  @@index([guildId, journeyId])
  @@index([creatorDiscordId, status])
  @@index([discordChannelId])
  @@index([discordThreadId])
}

model TicketNote {
  id              String       @id @default(cuid())
  ticketId        String
  guildId         String
  authorDiscordId String
  authorName      String
  content         String
  createdAt       DateTime     @default(now())

  guild           GuildConfig  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ticket          TicketRecord @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([guildId])
}

model TicketTranscript {
  id             String            @id @default(cuid())
  ticketId       String
  guildId        String
  /// 🆕 v2 — `SHAREABLE` (sans notes internes) ou `INTERNAL` (annexe staff).
  kind           TicketArchiveKind @default(SHAREABLE)
  /// Contenu HTML complet, ou chemin de fichier si la valeur ne commence pas par `<!DOCTYPE`.
  storageRef     String
  /// Messages **réellement capturés** (jamais gonflé : voir `partial`).
  messageCount   Int               @default(0)
  sizeBytes      Int               @default(0)
  /// 🆕 v2 — messages présents dans le salon, si la pagination a pu les compter.
  totalCount     Int?
  /// 🆕 v2 — `true` = la capture est incomplète : jamais présentée comme « archive complète ».
  partial        Boolean           @default(false)
  secretToken    String            @unique @default(cuid())
  /// 🆕 v2 — expiration (`null` = jamais) et révocation ; l'accès est journalisé.
  expiresAt      DateTime?
  revokedAt      DateTime?
  accessCount    Int               @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime          @default(now())

  guild          GuildConfig       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ticket         TicketRecord      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, kind])
  @@index([guildId])
  @@index([guildId, kind])
  @@index([expiresAt])
}

model TicketFeedback {
  id               String       @id @default(cuid())
  ticketId         String       @unique
  guildId          String
  creatorDiscordId String
  rating           Int
  comment          String?
  createdAt        DateTime     @default(now())

  guild            GuildConfig  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ticket           TicketRecord @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([guildId, rating])
}

model TicketAuditLog {
  id             String       @id @default(cuid())
  ticketId       String
  guildId        String
  actorDiscordId String
  actorName      String
  action         String
  detailsJson    Json?        @default("{}")
  createdAt      DateTime     @default(now())

  guild          GuildConfig  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ticket         TicketRecord @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([guildId, action])
}

// 🔐 #196 — Clés d'API Publique par guilde (scopes stricts, rate-limit, audit GOD)
model GuildApiKey {
  id              String      @id @default(cuid())
  guildId         String
  name            String
  keyHash         String      @unique
  prefix          String      // e.g. "sigil_live_ab12"
  scopes          String[]    @default(["read:members"])
  rateLimitPerMin Int         @default(60)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  guild           GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([prefix])
  @@index([revokedAt])
}

// ⚡ #158 — Matrice RBAC Commandes Slash Discord par Guilde
model GuildSlashCommandPermission {
  id          String      @id @default(cuid())
  guildId     String
  commandName String      // e.g. "almanax", "dofus", "profil", "sorties", "defi"
  roleIds     String[]    @default([])
  channelIds  String[]    @default([])
  isEnabled   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, commandName])
  @@index([guildId])
}




// ============================================================================
// 🛒 MODULE « MARCHÉ » (chantier 2026-09-10) — plan maître §6 (source de vérité)
// Isolation multi-tenant : `guildId` = GuildConfig.id (JAMAIS le snowflake).
// Toute requête filtre dessus ; l'isolation vient du contexte serveur.
// ============================================================================

enum MarketListingType {
  EQUIPMENT
  RESOURCE
  SERVICE
  WANTED
  /// 🧺 Décision user du 14/09/2026 — **lot multiple** : jusqu'à 5 objets
  /// différents (familles mélangées) vendus **ensemble**, chaque objet portant
  /// **son propre prix** (réservable séparément) et publié dans **son** message
  /// Discord. Cf. `refonte-marche/PLAN-LOT-MULTIPLE.md`.
  BUNDLE
}

/// Statut d'**un objet** d'un lot multiple (le lot lui-même garde son
/// `MarketListingStatus`).
enum MarketComponentStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum MarketListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  WITHDRAWN
}

enum MarketStatOrigin {
  NATIVE
  EXO
}

enum MarketStatQuality {
  LOW
  NORMAL
  GOOD
  PERFECT
  OVER
}

enum MarketOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum MarketReservationStatus {
  ACTIVE
  CANCELLED_BY_BUYER
  CANCELLED_BY_SELLER
  EXPIRED
  COMPLETED
}

enum MarketMediaType {
  PROOF_SCREENSHOT
  OTHER
}

enum MarketReportReason {
  JET_MISMATCH
  SELLER_UNREACHABLE
  BUYER_ABSENT
  SUSPICIOUS
  FORBIDDEN
  OTHER
}

enum MarketReportStatus {
  OPEN
  REVIEWED
  CLOSED
}


/// L'annonce — entité principale du marché.
model MarketListing {
  id             String              @id @default(cuid())

  // ── Isolation multi-tenant + propriété ──────────────────────────────────
  guildId        String              // = GuildConfig.id (JAMAIS le discordGuildId)
  profileId      String              // UserProfile du vendeur (membre de la guilde)
  userId         String              // propriétaire logique (autorisations, notifications)

  // ── Nature de l'annonce ─────────────────────────────────────────────────
  type           MarketListingType   @default(EQUIPMENT)
  status         MarketListingStatus @default(DRAFT)

  // ── Référence au catalogue d'objets (item réel, jamais inventé) ─────────
  dofusDbItemId  Int?                // = GameItem.ankamaId
  itemName       String?             // dénormalisé pour robustesse d'affichage
  itemIconUrl    String?
  itemLevel      Int?
  itemTypeName   String?             // « Anneau », « Bottes », « Familier »…

  // ── Forge réelle DÉCLARÉE (S8.10 · D40/D41) — additif, AUCUN backfill ────
  // L'état « Transcendé » est un CHOIX DU VENDEUR (jamais déduit du jet) :
  // la présence de `transcendenceRuneId` vaut `transcended` (aucun booléen
  // redondant). Une rune de Transcendance exclut tout over/exo (garde S8.11).
  transcendenceRuneId Int?      // = GameItem.ankamaId d'une rune (typeId 211)
  transcendenceLabel  String?   // libellé d'effet dénormalisé (repli : « Empêche les futures forgemagies »)
  strikeElement       String?   // élément de frappe (Feu|Eau|Terre|Air) — ARMES uniquement
  elementPotionId     Int?      // = GameItem.ankamaId de la potion (typeId 26) ; null si non siphonnée
  elementPotionTier   Int?      // palier de la potion (50|65|80) — porte la donnée de jeu
  huntingWeapon       String?   // libellé DÉCLARÉ de l'arme de chasse (ARMES uniquement)

  // ── Contenu ─────────────────────────────────────────────────────────────
  title          String              // titre affiché (pré-rempli : nom de l'item)
  description    String?             // note du vendeur (nettoyée, liens filtrés)
  forgedBy       String?             // « Modifié par » DÉCLARÉ (D11)

  // ── Prix & conditions (D4) ──────────────────────────────────────────────
  priceKamas     Int?                // ≤ 2 147 483 647 (garde Zod)
  negotiable     Boolean             @default(true)
  acceptsTrade   Boolean             @default(false)

  // ── Ressources / lots (D23, MVP) ────────────────────────────────────────
  quantity       Int?                // taille du lot (lot simple)
  unitLabel      String?             // « lot de 1 000 », « unité »…
  minQuantity    Int?                // quantité minimale par acheteur

  // ── Cycle de vie / échéances (indexé pour les crons) ────────────────────
  publishedAt    DateTime?
  expiresAt      DateTime?           // J+20 par défaut (D18) — échéance MAXIMALE
  reservedUntil  DateTime?
  soldAt         DateTime?
  withdrawnAt    DateTime?
  // Cycle de rappels piloté par paliers (D18) : 0 = aucun, 1 = J+7, 2 = J+15
  reminderStage  Int       @default(0)
  lastReminderAt DateTime?           // horodatage du dernier rappel (idempotence + anti-spam)
  renewCount     Int       @default(0)   // Q10=C : prolongation UNE SEULE fois
  // « Aucun échange ni interaction » : mis à jour à chaque offre, réservation, vente
  lastActivityAt DateTime  @default(now())
  // Suppression automatique à J+20 (D18) : soft-delete (traçabilité) puis purge différée
  deletedAt      DateTime?
  deletedReason  String?             // AUTO_EXPIRED | SELLER | MODERATION | GUILD

  // ── Anticipation inter-guilde (D24) — réservé, NON utilisé au MVP ───────
  visibility     String    @default("GUILD")   // GUILD | INTER_GUILD (V2)

  // ── Anti-duplication & intégrité serveur ────────────────────────────────
  statsHash      String?             // MD5 des stats déclarées → cache de la carte PNG
  moderationNote String?             // motif du dernier retrait modo

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // ── Relations ───────────────────────────────────────────────────────────
  guild          GuildConfig           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile        UserProfile           @relation("MarketListingsAsSeller", fields: [profileId], references: [id], onDelete: Cascade)
  stats          MarketListingStat[]
  components     MarketListingComponent[]
  offers         MarketOffer[]
  reservations   MarketReservation[]
  media          MarketListingMedia[]
  reports        MarketReport[]
  discordMessage MarketDiscordMessage?
  auditLogs      MarketAuditLog[]

  @@index([guildId, status])
  @@index([guildId, type, status])
  @@index([guildId, status, expiresAt])   // cron d'expiration
  @@index([profileId, status])            // « Mes annonces »
  @@index([guildId, dofusDbItemId])       // prix moyen guilde par item
}


/// Le jet déclaré (le cœur de la valeur). `quality` est TOUJOURS recalculée serveur.
model MarketListingStat {
  id             String            @id @default(cuid())
  listingId      String

  effectId       Int               // identifiant d'effet DofusDB (stabilité inter-versions)
  characteristic Int?              // identifiant de caractéristique (icône/couleur)
  label          String            // libellé FR figé au moment de la déclaration

  naturalMin     Int?              // plage native (issue du CATALOGUE, jamais du client)
  naturalMax     Int?
  actualValue    Int               // valeur déclarée par le vendeur

  origin         MarketStatOrigin  @default(NATIVE)   // NATIVE | EXO
  quality        MarketStatQuality @default(NORMAL)   // RECALCULÉE côté serveur (D17)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  listing        MarketListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, effectId, origin])   // une ligne par effet et par origine
  @@index([listingId])
}

/// Contenu d'un lot de ressources (lot simple ou composite, D23).
model MarketListingComponent {
  id            String        @id @default(cuid())
  listingId     String
  position      Int           @default(0)     // ordre d'affichage dans le lot

  dofusDbItemId Int?                          // référence catalogue (ressource)
  name          String                        // « Bois de Frêne »
  iconUrl       String?
  quantity      Int                           // 1 000
  unitLabel     String?                       // « unité », « lot », « kamas »…

  // ── 🧺 Lot multiple (décision user du 14/09/2026) ─────────────────────────
  // Le **prix vit sur l'objet** (et non sur l'annonce) : chaque objet est
  // réservable séparément. `status` suit l'objet, pas le lot.
  priceKamas    Int?                          // prix de CET objet (kamas)
  status        MarketComponentStatus @default(AVAILABLE)
  reservedAt    DateTime?
  soldAt        DateTime?

  // ── 🧺 Option A — un message Discord **par objet** ────────────────────────
  // Le message de l'**annonce** reste dans `MarketDiscordMessage`
  // (`componentId = NULL`) ; ces deux colonnes portent le message **dédié à cet
  // objet** (embed + boutons propres, réservation à son prix).
  discordChannelId String?
  discordMessageId String?

  createdAt     DateTime      @default(now())

  listing       MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Réservations **ciblant cet objet** (lot multiple).
  reservations  MarketReservation[]
  /// Messages Discord **de cet objet** (un message par objet, option A).
  discordMessages MarketDiscordMessage[]

  @@index([listingId, position])
  @@index([listingId, status])   // « quels objets restent disponibles ? »
}

/// La négociation (offre / contre-offre).
model MarketOffer {
  id                String            @id @default(cuid())
  listingId         String
  buyerProfileId    String            // UserProfile de l'acheteur
  buyerUserId       String

  offeredKamas      Int?              // au moins UN des deux (kamas OU troc)
  tradeDescription  String?           // description libre du troc
  note              String?           // message au vendeur (max 500, nettoyé)

  status            MarketOfferStatus @default(PENDING)
  counterOfId       String?           // si contre-offre : offre d'origine
  respondedAt       DateTime?
  respondedByUserId String?
  expiresAt         DateTime?         // 48 h par défaut

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  listing           MarketListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerProfileId, status])
  @@index([status, expiresAt])       // cron d'expiration des offres
}

/// L'intention d'achat au prix.
model MarketReservation {
  id                 String                   @id @default(cuid())
  listingId          String
  /// 🧺 Lot multiple — **objet ciblé** (`null` = annonce entière, cas
  /// historique). Une réservation ne porte que sur **un** objet.
  componentId        String?
  buyerProfileId     String
  buyerUserId        String

  status             MarketReservationStatus  @default(ACTIVE)
  expiresAt          DateTime                  // durée de guilde (12 h par défaut)
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?

  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  listing            MarketListing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  component          MarketListingComponent?   @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([buyerProfileId, status])
  @@index([status, expiresAt])       // cron de libération
  @@index([componentId, status])     // « cet objet est-il déjà réservé ? »
}


/// Preuves facultatives (captures) — clé de stockage, jamais une URL fragile.
model MarketListingMedia {
  id              String          @id @default(cuid())
  listingId       String
  type            MarketMediaType @default(PROOF_SCREENSHOT)

  storageKey      String          // /api/storage/...
  mimeType        String          // image/png | image/jpeg | image/webp uniquement
  sizeBytes       Int
  createdByUserId String

  createdAt       DateTime        @default(now())

  listing         MarketListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

/// Suivi du message Discord publié (1 annonce = 1 message au MVP).
model MarketDiscordMessage {
  id                       String        @id @default(cuid())
  listingId                String        @unique
  /// 🧺 Lot multiple (option A) — **objet** dont ce message porte l'embed et
  /// les boutons (`null` = message de l'annonce elle-même, cas historique).
  componentId              String?

  discordGuildId           String        // snowflake Discord (traçabilité de l'app utilisée)
  discordChannelId         String
  discordMessageId         String

  generatedImageStorageKey String?       // clé locale de la carte PNG mise en cache
  lastSyncedAt             DateTime      @default(now())
  syncStatus               String        @default("OK")   // OK | PENDING | FAILED
  lastError                String?

  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  listing                  MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  component                MarketListingComponent? @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([discordGuildId, syncStatus])
  @@index([componentId])
}

/// Signalement d'une annonce (dossiers humains, aucune sanction automatique).
model MarketReport {
  id                String             @id @default(cuid())
  listingId         String
  reporterUserId    String
  reporterProfileId String

  reason            MarketReportReason @default(OTHER)
  details           String?            // texte libre, nettoyé
  snapshot          Json?              // état figé de l'annonce au moment du signalement

  status            MarketReportStatus @default(OPEN)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  resolution        String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  listing           MarketListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, status])
  @@index([status, createdAt])
}

/// Journal d'audit du marché (rétention 365 j par défaut, cf. §15.2).
model MarketAuditLog {
  id           String         @id @default(cuid())
  guildId      String
  listingId    String?
  actorUserId  String?        // qui (null = système / cron)

  action       String         // cf. MARKET_AUDIT_ACTIONS (constantes typées)
  previousData Json?
  nextData     Json?
  reason       String?

  createdAt    DateTime       @default(now())

  listing      MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([guildId, createdAt])
  @@index([listingId])
}

