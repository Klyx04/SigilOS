generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -- Auth.js Models --

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // SigilOS Relations
  profiles            UserProfile[]
  guildEvents         GuildEvent[]
  eventParticipations EventParticipant[]
  notifications       Notification[]

  // Songes Relations
  dreamRuns          DreamRun[]         @relation("RunLeader")
  dreamRunMembers    DreamRunMember[]
  dreamWaitlists     DreamWaitlist[]
  dreamJoinRequests  DreamJoinRequest[]

  // Lifecycle tracking (RGPD)
  deletionRequestedAt DateTime?
  scheduledDeletion   DateTime?
  emailBackup         String?  // Pour contact avant suppression

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// -- SigilOS Core Models --

// Platform-level guild whitelist (managed by super-admin)
model AllowedGuild {
  id             String    @id @default(cuid())
  discordGuildId String    @unique
  name           String? // Cached guild name
  tier           String    @default("BETA") // BETA, FREE, PREMIUM (for future monetization)
  isActive       Boolean   @default(true) // Quick enable/disable
  addedBy        String // Discord ID of super-admin who added
  addedAt        DateTime  @default(now())
  expiresAt      DateTime? // Null = permanent, or expiration date
  notes          String? // Internal notes (e.g. "Beta partner", "Paid tier")

  @@index([discordGuildId])
  @@index([isActive])
}

// Global platform-level bans
model PlatformBan {
  id         String   @id @default(cuid())
  entityType String   // "GUILD" | "USER"
  discordId  String   @unique
  reason     String
  bannedBy   String   // Super-admin ID
  createdAt  DateTime @default(now())

  @@index([discordId])
  @@index([entityType])
}

model GuildConfig {
  id               String  @id @default(cuid())
  discordGuildId   String  @unique
  name             String
  ownerId          String? // Discord ID of the guild owner
  iconUrl          String?
  isActive         Boolean @default(true)
  rolesMapping     Json    @default("{}") // Record<DiscordRoleId, PermissionId[]>
  absenceChannelId String? // Discord channel ID for absence notifications
  metamobApiKey    String? // Per-guild Metamob API key (optional, falls back to global)
  maxMembers       Int     @default(350) // Maximum number of active members allowed

  // Dofus Server Configuration (for Ladder scraping)
  dofusServerId   String? // Ex: "295" for Draconiros
  dofusServerName String? // Ex: "Draconiros" (display name)

  // Songes Module Configuration
  songesNotifyChannelId String? // Discord channel ID for Songes join request notifications

  // Calendar Module Configuration  
  calendarNotifyChannelId String? // Discord channel ID for calendar event notifications

  // Bonus Module Configuration
  bonusNotifyChannelId String? // Discord channel ID for bonus purchase notifications

  // Mission Configuration
  missionRanks         Json? // [1, 2, 3, 4] - Selected ranks for mission generation
  missionTier          Int?    @default(3) // Selected Tier (Palier) target (1-5)
  missionNotifyChannelId String? // Discord channel ID for mission notifications
  missionNotifyRoleId    String? // Discord role ID to ping for mission notifications

  // === GUILD PRESENTATION MODULE ===
  presentationEnabled      Boolean   @default(false) // Visible in public directory
  presentationHistory      String?   @db.Text // Guild history (Markdown, emojis allowed)
  presentationActivities   Json? // ["Économie", "PVM", "Roleplay", "Kolizéum", "Percepteur"]
  presentationFounder      String? // Founder pseudo
  presentationCoLeaders    Json? // ["pseudo1", "pseudo2", "pseudo3"] - Up to 3 co-leaders
  presentationTeam         Json? // ["pseudo1", "pseudo2", ...] - Up to 10 bras droits (free text)
  presentationDiscord      String? // Discord invite link (sanitized)
  presentationRecruiting   Boolean   @default(false) // Recruiting status
  presentationRecruitReq   String?   @db.Text // Recruitment requirements (Markdown)
  presentationServer       String? // Dofus Unity server name
  presentationFoundedDate  DateTime? // Date of guild creation (roleplay/historical)
  presentationBannerType   String?   @default("discord") // "discord" | "custom"
  presentationBannerUrl    String? // Custom banner URL (if uploaded)
  presentationPhotoUrl     String? // Guild photo URL (uploaded)
  // Recruitment specific fields
  presentationDiscordReq   Boolean   @default(false) // Discord required for recruitment
  presentationMinLevel     Int? // Min level (0-200)
  presentationMinSuccesses Int? // Min successes (0-25000)

  // Lifecycle tracking
  deletedAt         DateTime?
  deletionReason    String?   // "SERVER_DELETED", "BOT_REMOVED", "ADMIN_REQUEST"
  scheduledDeletion DateTime? // Date de hard delete planifiée

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles               UserProfile[]
  missions               Mission[]
  auditLogs              AuditLog[]
  guildEvents            GuildEvent[]
  achievementSubmissions AchievementSubmission[]
  guildBonuses           GuildBonus[]
  modules                GuildModules?
}

// -- Guild Modules (Feature Flags) --
// Allows enabling/disabling features per guild (Dyno-style)
model GuildModules {
  id      String      @id @default(cuid())
  guildId String      @unique
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // === GÉNÉRAL ===
  presentation Boolean @default(true) // Page de présentation de la guilde
  roster       Boolean @default(true) // Annuaire des membres
  stats        Boolean @default(true) // Stats Guilde (futur)
  calendar     Boolean @default(true) // Calendrier des événements

  // === FONCTIONNALITÉS ===
  missions Boolean @default(true) // Missions hebdomadaires
  songes   Boolean @default(true) // Runs Songes
  ocre     Boolean @default(true) // Quête Ocre / Metamob
  ladder   Boolean @default(true) // Classement Dofus

  // === OUTILS ===
  services Boolean @default(true) // Services Guilde (passages, etc.)
  donjons  Boolean @default(true) // Donjons & Quêtes (finder)
  profile  Boolean @default(true) // Profil membre
  docs     Boolean @default(true) // Documentation / Wiki

  // === ADMIN ===
  logs Boolean @default(true) // Logs d'audit admin
  polls Boolean @default(true) // Sondages de guilde
  admin Boolean @default(true) // Accès administration

  updatedAt DateTime @updatedAt
  updatedBy String?  // Discord user ID of last admin who changed settings
}

// -- Audit Log (Immutable) --
// Tracks all administrative actions for security and compliance
// IMPORTANT: This table has NO updatedAt field - logs are immutable

model AuditLog {
  id          String @id @default(cuid())
  guildId     String
  actorUserId String // User who performed the action
  actorName   String // Actor name at time of action (for historical reference)

  action     String // Action type: RBAC_UPDATE, RBAC_ROLE_ADD, RBAC_ROLE_REMOVE, etc.
  targetType String // Target entity type: PERMISSION, ROLE, CONFIG, etc.
  targetId   String? // ID of the target if applicable

  oldValue Json? // State before modification
  newValue Json? // State after modification
  metadata Json? // Additional context data

  createdAt DateTime @default(now())

  // Note: NO updatedAt - Logs are immutable and cannot be modified
  // Note: NO onDelete Cascade from User - Logs persist even if user is deleted

  guild GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model UserProfile {
  id      String @id @default(cuid())
  userId  String
  guildId String

  status ProfileStatus @default(ACTIVE)

  // RGPD Lifecycle Management
  archivedAt    DateTime? // When the profile was archived (for retention policy)
  archiveReason String? // "LEFT" | "KICKED" | "BANNED" | "GDPR_REQUEST"

  // Identity
  pseudoDofus       String?
  classe            String?
  classeSecondaires Json? // String[] - Up to 3 alt classes

  // Jobs & Crafting
  metiers          Json? // String[] - List of max-level jobs
  forgemagieStatus String? @default("UNAVAILABLE") // "FREE" | "PAID" | "UNAVAILABLE"

  // Forgemagie Pricing (Kamas)
  fmPriceClassic Int? // Prix pour FM classique
  fmPriceTrans   Int? // Prix pour passage rune Trans
  fmPriceExo     Int? // Prix pour tentative Exo/Over

  // Achievements (V2)
  succes Json? // List of validated achievements

  // Gamification
  xp                  Int       @default(0)
  guildatons          Int       @default(0)
  achievementPoints   Int? // Points de succès Dofus (manual or scraped)
  achievementLastSync DateTime? // Last successful sync from dofus.com

  // Dofus Identity (for Ladder scraping)
  dofusPseudo String? // Pseudo EXACT in-game (case-sensitive)

  // Availability Heatmap
  availability Json? // { "lundi": ["matin", "soir"], ... }

  // Vacation Mode
  vacationStart  DateTime?
  vacationEnd    DateTime?
  vacationNotify Boolean   @default(false)

  // Activity Tracking
  lastActivityAt   DateTime?
  lastActivityDesc String?

  // Discord Cache (refreshed periodically)
  discordNickname       String?
  discordRoleName       String?
  discordRoleColor      Int?
  discordJoinedAt       DateTime?
  discordCacheUpdatedAt DateTime?

  // Metamob Integration (Quête Ocre - API v2)
  metamobPseudo    String? // Pseudo Metamob (peut être différent du pseudo Dofus)
  metamobApiKey    String? // Clé API personnelle pour accès doublons/exchangeable
  metamobQuestSlug String? // Slug de la quête active (ex: "mon-perso-278")
  metamobServerId  Int? // ID du serveur Dofus (ex: 401 = Draconiros)
  metamobVerified  Boolean   @default(false) // Compte validé via API
  metamobLastSync  DateTime? // Dernière synchronisation du cache

  // Alt Characters (up to 5-6 pseudos for other in-game characters)
  altPseudos Json? // String[] - ["AltName1", "AltName2", ...]

  // Notification Preferences
  notificationPrefs Json? // { "missions": true, "songes": true, "events": true }

  // Lifecycle tracking (uses existing archivedAt/archiveReason + scheduledDeletion)
  scheduledDeletion DateTime? // Date de hard delete planifiée (for RGPD compliance)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild                  GuildConfig             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  submissions            Submission[]
  interests              MissionInterest[]
  achievementSubmissions AchievementSubmission[]
  guildBonuses           GuildBonus[] // Bonuses purchased by this user

  // DofusBook Integration
  dofusBookLinks Json? // [{ id, url, name }]

  // Gamification (OCR Success)
  successPoints    Int?      @default(0)
  lastLadderUpdate DateTime?

  // Entraide (Help Credits)
  entraidePoints Int @default(0) // Cumulative points from received help credits

  // Guild Contribution System
  contributionPoints Int          @default(0)
  helpedSubmissions  Submission[] @relation("SubmissionHelpers")

  // Relations
  givenCredits    HelpCredit[] @relation("GivenCredits")
  receivedCredits HelpCredit[] @relation("ReceivedCredits")

  @@unique([userId, guildId])
}

model Mission {
  id      String @id @default(cuid())
  guildId String

  category MissionCategory
  status   MissionStatus   @default(ACTIVE)

  tier Int @default(1) // Palier 1-5 (Reward Level)
  rank Int @default(1) // Rank 1-4 (Content Level: 1=30-109, 2=110-169, 3=170-199, 4=200)

  xpReward         Int? // Guild XP (Purple Star)
  guildatonsReward Int? // Personal Currency (Yellow Coin)

  title   String? // Optional override title
  payload Json // Mission details (Boss, Zone, etc)

  weekNumber Int
  year       Int
  slotIndex  Int @default(0) // 0-11

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild       GuildConfig       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  submissions Submission[]
  interests   MissionInterest[]

  @@unique([guildId, weekNumber, year, slotIndex])
  @@index([guildId, weekNumber, year])
}

model MissionInterest {
  id        String @id @default(cuid())
  missionId String
  profileId String

  createdAt DateTime @default(now())

  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([missionId, profileId])
}

model Submission {
  id        String @id @default(cuid())
  missionId String
  profileId String

  status      SubmissionStatus @default(PENDING)
  proofUrl    String
  validatorId String?

  // OCR Analysis Results
  ocrScore  Float? // 0-100 confidence score
  ocrResult Json? // { matches: [...], rawText: string }
  ocrStatus OcrStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  helpers UserProfile[] @relation("SubmissionHelpers")
}

model AchievementSubmission {
  id        String @id @default(cuid())
  profileId String
  guildId   String

  status   SubmissionStatus @default(PENDING)
  points   Int
  proofUrl String           @db.Text

  ocrScore   Float?
  ocrRawText String? @db.Text

  validatorId String?
  validatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([profileId])
}

// -- Game Data (Reference Tables) --

model Dungeon {
  id       String  @id @default(cuid())
  name     String  @unique
  bossName String
  level    Int
  dpnlUrl  String? // Lien dofuspourlesnoobs
  imageUrl String? // Image du boss

  // Expédition metadata
  isExpedition        Boolean @default(false)
  expeditionModes     Json? // ["BRAVOURE", "AUDACE", "NORMAL"]
  expeditionMechanics String? @db.Text // Description mécaniques alternatives

  // Relations
  achievements DungeonAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([isExpedition])
}

model Zone {
  id        String   @id @default(cuid())
  name      String   @unique
  level     Int
  dpnlUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  families MonsterFamily[]

  @@index([name])
}

model Monster {
  id       String  @id @default(cuid())
  name     String
  familyId String // Remplace zoneId pour organisation par famille
  level    Int?
  imageUrl String?

  family MonsterFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([name])
}

// -- New Game Data Models --

model MonsterFamily {
  id          String  @id @default(cuid())
  name        String  @unique // Ex: "Blops", "Dragoeufs", "Bouftous"
  description String? @db.Text
  imageUrl    String?

  monsters Monster[]
  zones    Zone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Challenge {
  id          String  @id @default(cuid())
  name        String  @unique // Ex: "Misanthrope", "Premier", "Économe"
  slug        String  @unique // Ex: "misanthrope", "premier"
  description String? @db.Text
  iconUrl     String?


  // Conditions générales du challenge (optionnel)
  conditions Json? // { "maxInvocations": 0, "maxAllies": 1, etc. }

  dungeonAchievements DungeonAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([name])
}

model DungeonAchievement {
  id          String @id @default(cuid())
  dungeonId   String
  challengeId String

  // Récompense de ce succès spécifique (points de succès Dofus)
  points Int @default(10)

  // Icône/image custom du succès si différent du challenge
  imageUrl String?

  dungeon   Dungeon   @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([dungeonId, challengeId])
  @@index([dungeonId])
  @@index([challengeId])
}

// -- Enums --

enum ProfileStatus {
  ACTIVE
  ARCHIVED
  BANNED
}

enum MissionCategory {
  DONJON
  REGULATION
  ANOMALIE
  SONGES
  EXPEDITION
  EVENT
}

enum MissionStatus {
  ACTIVE
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum AnomalieType {
  ZONE
  BOSS
}

enum SongesDifficulty {
  REVE
  PARADOXE
  CAUCHEMAR
}

enum ExpeditionMode {
  BRAVOURE
  AUDACE
  AUCUN
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  MISSION_VALIDATED
  MISSION_REJECTED
  NEW_SUBMISSION_PENDING
  SYSTEM_INFO
  SONGES_JOIN_REQUEST // New candidature for Songes run
  EVENT_REMINDER // Event reminder notification
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  title   String
  message String
  type    NotificationType
  read    Boolean          @default(false)
  link    String? // Optional redirection link

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -- SONGES MODULE --

model DreamRun {
  id       String @id @default(cuid())
  guildId  String // Multi-tenant isolation
  leaderId String // User who created the run

  leader User @relation("RunLeader", fields: [leaderId], references: [id], onDelete: Cascade)

  // Configuration
  difficulty DreamDifficulty
  objective  DreamObjective?  @default(FUN) // DEPRECATED: Use objectives
  objectives DreamObjective[] // New multi-select field

  // State
  status       DreamRunStatus @default(RECRUITING)
  currentFloor Int            @default(0) // 0 = not started, 1-26 = in progress
  pointsReve   Int            @default(0) // Accumulated dream points

  minorBonuses Json? // List of acquired minor bonuses

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  lastReminderAt DateTime? // For cooldown/spam protection
  startedAt   DateTime? // When run actually started
  completedAt DateTime? // When run ended (victory/defeat/abandon)

  // Notification settings
  notifyOnJoinRequest Boolean @default(true)

  // Discord embed tracking
  discordMessageId    String?
  discordChannelId    String?

  // Relations
  members      DreamRunMember[]
  waitlist     DreamWaitlist[]
  floors       DreamFloor[]
  bonuses      DreamRunBonus[]
  joinRequests DreamJoinRequest[]
  reminders    DreamRunReminder[]

  @@index([guildId, status])
  @@index([leaderId])
}

model DreamRunMember {
  id       String   @id @default(cuid())
  runId    String
  userId   String // Reference to User.id
  slot     Int // 1-4 (position in team)
  joinedAt DateTime @default(now())

  run  DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@unique([runId, slot])
}

model DreamWaitlist {
  id        String   @id @default(cuid())
  runId     String
  userId    String // Reference to User.id
  position  Int // Position in queue (1 = first)
  createdAt DateTime @default(now())

  run  DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([runId, position])
}

model DreamFloor {
  id          String @id @default(cuid())
  runId       String
  floorNumber Int // 1-26

  // Room info
  roomType   DreamRoomType
  difficulty Int? // Difficulty score (5-60) for combat rooms

  // Results
  pointsReveGained Int      @default(0)
  completedAt      DateTime @default(now())

  run DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, floorNumber])
}

model DreamRunBonus {
  id          String   @id @default(cuid())
  runId       String
  bonusName   String // Name from bonus_songes.json
  bonusType   String // passif, actif, bonus, consommable
  bonusRarete String // Commun, Rare, Épique, Légendaire
  cost        Int // Points de Rêve spent
  acquiredAt  DateTime @default(now())

  run DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// -- SONGES ENUMS --

enum DreamDifficulty {
  REVE_I
  REVE_II
  REVE_III
  PARADOXE_I
  PARADOXE_II
  PARADOXE_III
  PARADOXE_IV
  CAUCHEMAR_I
  CAUCHEMAR_II
  CAUCHEMAR_III
}

enum DreamObjective {
  MISSION_GUILDE // Weekly guild mission
  DROP_LEGENDE // Farming legendaries
  SUCCES_NO_ACHAT // Achievement (no purchases)
  FUN // Just for fun
  QUETE // Quest
}

enum DreamRunStatus {
  RECRUITING // Looking for members
  IN_PROGRESS // Run active
  COMPLETED // Victory (floor 26 cleared)
  FAILED // Defeat
  ABANDONED // Leader left
}

enum DreamRoomType {
  COMBAT // Monster group
  FONTAINE // Shop (buy bonuses)
  FAVEUR // Free random bonus
  BOSS // Final boss (floor 26)
  ENTREE // Room 0 (New)
}

model DreamJoinRequest {
  id          String            @id @default(cuid())
  runId       String
  userId      String // User requesting to join
  classe      String // Dofus class name
  message     String? // Optional message ("Cra opti dispo")
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  // Discord tracking for cleanup
  discordMessageId String?
  discordChannelId String?

  run  DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([runId, status])
}

model DreamRunReminder {
  id               String   @id @default(cuid())
  runId            String
  discordMessageId String
  discordChannelId String
  createdAt        DateTime @default(now())

  run DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// -- CALENDAR MODELS V2 --

// Types d'événements Dofus
enum GuildEventType {
  RAID_OFFICIAL // Raids MaJ 3.6 (1/semaine par joueur)
  EVENT_GUILD // Mini-jeux RP/Social (Nibar, Chafer Crit, etc.)
  SESSION_MISSIONS // Sorties missions guilde (drop/métiers)
  SORTIE_FARM // Farm/Koli interne
  ALMANAX_BONUS // Auto-généré quotidien
  // Legacy types (rétrocompatibilité)
  GUILD_MISSION
  SONGES_RUN
  DUNGEON_FARM
  SOCIAL
  OFFICIAL_RESET
  OTHERS
}

enum EventStatus {
  DRAFT // Brouillon (non visible)
  PUBLISHED // Visible et inscriptions ouvertes
  COMPLETED // Terminé (points distribués)
  CANCELLED // Annulé
}

enum RecurrenceType {
  UNIQUE // Événement unique
  WEEKLY // Chaque semaine
  MONTHLY // Chaque mois
}

enum ParticipantStatus {
  REGISTERED // Titulaire inscrit
  RESERVE // En file d'attente
  CONFIRMED // Auto-promu et confirmé
  DECLINED // Désisté
}

// Ancien enum conservé pour compatibilité
enum AttendeeStatus {
  GOING
  MAYBE
  DECLINED
}

model GuildEvent {
  id        String @id @default(cuid())
  guildId   String
  creatorId String // Capitaine/Organisateur

  // Infos de base
  title       String
  description String?        @db.Text
  type        GuildEventType @default(SOCIAL)
  status      EventStatus    @default(DRAFT)

  // Timing
  startDate DateTime
  endDate   DateTime

  // Récurrence
  recurrence    RecurrenceType @default(UNIQUE)
  parentEventId String? // Pour instances d'events récurrents

  // Configuration
  location        String? // Lieu in-game ou channel Discord
  maxParticipants Int? // Limite (ex: 12 pour raid)

  // Discord Sync
  discordMessageId String? // ID du message embed
  discordChannelId String? // Channel où poster

  // Métadonnées dynamiques par type
  // { raidBoss, eventTemplate, pollOptions, etc. }
  metadata Json?

  // Notifications
  notifyBefore   Int?      @default(60) // Minutes avant event
  lastRemindedAt DateTime? // Dernier rappel envoyé

  // Validation (Raids)
  proofUrl    String? // Screenshot preuve victoire
  validatedAt DateTime? // Date validation
  validatedBy String? // User qui a validé

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guild        GuildConfig        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  participants EventParticipant[]

  @@index([guildId, startDate])
  @@index([guildId, status])
  @@index([creatorId])
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String

  status   ParticipantStatus @default(REGISTERED)
  position Int // 1-N titulaires, N+1... réserve
  classe   String? // Classe Dofus (pour raids)
  comment  String? // Note ("Dispo 15min après")

  // Auto-promotion
  promotedAt  DateTime? // Quand promu de la réserve
  confirmedAt DateTime? // Confirmation après promotion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event GuildEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, position])
}

// =============================================================================
// OCR LLM - Image Hash (Anti-Duplicate System)
// =============================================================================
// Stores SHA-256 hashes of uploaded images to prevent resubmission
// Same image cannot be used twice within the same guild

model ImageHash {
  id      String @id @default(cuid())
  guildId String // Multi-tenant isolation

  // SHA-256 hash of the image data (64 hex characters)
  hash String

  // Context of the original submission
  sourceType String // "MISSION" | "ACHIEVEMENT" | "EVENT"
  sourceId   String // Reference to Submission.id or AchievementSubmission.id

  // Who uploaded it
  uploaderId String // User.id

  // When it was uploaded
  createdAt DateTime @default(now())

  // Unique per guild - same image can be uploaded by different guilds
  @@unique([guildId, hash])
  @@index([guildId])
  @@index([hash])
  @@index([uploaderId])
}

// =============================================================================
// ENTRAIDE - Help Credits (Peer-to-Peer Gratitude)
// =============================================================================
// When completing a mission, members can thank those who helped
// Each credit = points on the Ladder

model HelpCredit {
  id      String @id @default(cuid())
  guildId String // Multi-tenant isolation

  // Who is thanking
  fromUserId String // User.id of the person giving credit

  // Who is being thanked
  toUserId String // User.id of the person receiving credit

  // Context (optional)
  missionId String? // Related mission (if any)
  message   String? // Optional thank you message (max 100 chars)

  // Points awarded (default 5, configurable)
  points Int @default(5)

  createdAt DateTime @default(now())

  // Relations
  fromProfile UserProfile @relation("GivenCredits", fields: [fromUserId, guildId], references: [userId, guildId], onDelete: Cascade)
  toProfile   UserProfile @relation("ReceivedCredits", fields: [toUserId, guildId], references: [userId, guildId], onDelete: Cascade)

  // Indexes for queries
  @@index([guildId, toUserId]) // Get all credits received by user
  @@index([guildId, fromUserId]) // Get all credits given by user
  @@index([guildId, fromUserId, createdAt]) // For daily limit checks
}

// -- OCR API Usage Tracking --
// Tracks OCR.space API calls for monitoring on /god page

model OcrApiUsage {
  id       String   @id @default(cuid())
  date     DateTime @default(now()) @db.Date // Daily aggregation
  endpoint String // "profile" | "ladder" etc.
  count    Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, endpoint])
  @@index([date])
}

// -- Guild Bonus System --
// Manages guild bonus purchases with 24h countdown before activation

model GuildBonus {
  id      String      @id @default(cuid())
  guildId String
  guild   GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  bonusType BonusType
  cost      Int // Kamas cost

  // Status tracking
  status      BonusStatus @default(PURCHASED)
  purchasedAt DateTime    @default(now())
  purchasedBy String? // User ID who purchased (nullable for legacy data)
  purchaser   UserProfile? @relation(fields: [purchasedBy], references: [id], onDelete: SetNull)

  // Activation timing
  activatesAt DateTime // purchasedAt + 24h
  expiresAt   DateTime? // activatesAt + 2h (when status = ACTIVE)

  // Discord notification
  notificationChannelId String?
  notificationMessageId String?
  mentionType           MentionType @default(NONE)
  mentionRoleId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([activatesAt])
}

enum BonusType {
  FORTUNE // +50% loot
  GLADIATOR // +50% kolizeum
  HARVESTER // Rékloots
  WISDOM // +50% XP
  DIVINE // Moissonneuse event
}

enum BonusStatus {
  PURCHASED // Countdown active (0-24h)
  ACTIVE // Bonus active (2h duration)
  EXPIRED // Bonus ended
}

enum MentionType {
  NONE
  EVERYONE
  ROLE
}

// -- DOCUMENTATION MODULE --

enum DocAccessLevel {
  PUBLIC
  ADMIN
}

model DocPage {
  id          String         @id @default(cuid())
  slug        String         @unique // e.g., "intro", "guilds/join"
  title       String
  content     String         @db.Text // Markdown content
  category    String // e.g., "Démarrage", "Fonctionnalités"
  order       Int            @default(0)
  isPublished Boolean        @default(true)
  accessLevel DocAccessLevel @default(PUBLIC)
  guildId     String? // If null, global/system doc. If set, specific to a guild.

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category, order])
  @@index([slug])
  @@index([guildId, accessLevel])
}

// -- CHANGELOG MODULE --

model ChangelogEntry {
  id          String            @id @default(cuid())
  version     String            // e.g., "v1.3.0"
  title       String            // e.g., "Webhook Automation + Changelog"
  summary     String?            // Short marketing description (1-2 lines) for landing page (optional)
  content     String            @db.Text // Full markdown content for detailed view
  category    ChangelogCategory
  isInternal  Boolean           @default(false) // Internal entries only visible to authenticated guild members
  publishedAt DateTime          @default(now())
  publishedBy String            // Super-admin user ID
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([publishedAt])
  @@index([category])
}

enum ChangelogCategory {
  FEATURE      // New features
  BUGFIX       // Bug fixes
  SECURITY     // Security improvements
  PERFORMANCE  // Performance optimizations
  DOCUMENTATION // Documentation updates
}
