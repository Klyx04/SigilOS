generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String             @id @default(cuid())
  name                String?
  email               String?            @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  deletionRequestedAt DateTime?
  emailBackup         String?
  scheduledDeletion   DateTime?
  lastSeenChangelogId String?
  accounts            Account[]
  dreamJoinRequests   DreamJoinRequest[]
  dreamRuns           DreamRun[]         @relation("RunLeader")
  dreamRunMembers     DreamRunMember[]
  dreamWaitlists      DreamWaitlist[]
  eventParticipations EventParticipant[]
  guildEvents         GuildEvent[]
  notifications       Notification[]
  sessions            Session[]
  profiles            UserProfile[]
}

model AllowedGuild {
  id             String    @id @default(cuid())
  discordGuildId String    @unique
  name           String?
  tier           String    @default("BETA")
  isActive       Boolean   @default(true)
  addedBy        String
  addedAt        DateTime  @default(now())
  expiresAt      DateTime?
  notes          String?

  @@index([discordGuildId])
  @@index([isActive])
}

model PlatformBan {
  id         String   @id @default(cuid())
  entityType String
  discordId  String   @unique
  reason     String
  bannedBy   String
  createdAt  DateTime @default(now())

  @@index([discordId])
  @@index([entityType])
}

model GuildConfig {
  id                            String                  @id @default(cuid())
  discordGuildId                String                  @unique
  name                          String
  iconUrl                       String?
  isActive                      Boolean                 @default(true)
  rolesMapping                  Json                    @default("{}")
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  absenceChannelId              String?
  calendarNotifyChannelId       String?
  dofusServerId                 String?
  dofusServerName               String?
  metamobApiKey                 String?
  presentationActivities        Json?
  presentationBannerType        String?                 @default("discord")
  presentationBannerUrl         String?
  presentationCoLeaders         Json?
  presentationDiscord           String?
  presentationDiscordReq        Boolean                 @default(false)
  presentationEnabled           Boolean                 @default(false)
  presentationFoundedDate       DateTime?
  presentationFounder           String?
  presentationHistory           String?
  presentationMinLevel          Int?
  presentationMinSuccesses      Int?
  presentationPhotoUrl          String?
  presentationRecruitReq        String?
  presentationRecruiting        Boolean                 @default(false)
  presentationServer            String?
  presentationTeam              Json?
  songesNotifyChannelId         String?
  missionRanks                  Json?
  missionTier                   Int?                    @default(3)
  bonusNotifyChannelId          String?
  deletedAt                     DateTime?
  deletionReason                String?
  scheduledDeletion             DateTime?
  maxMembers                    Int                     @default(350)
  ownerId                       String?
  missionNotifyChannelId        String?
  missionNotifyRoleId           String?
  pollsNotifyChannelId          String?
  pollsNotifyRoleId             String?
  ocreNotifyChannelId           String?
  djNotifyChannelId             String?
  servicesNotifyChannelId       String?
  loansNotifyChannelId          String?
  systemNotifyChannelId         String?
  welcomeEnabled                Boolean                 @default(false)
  welcomeNotifyChannelId        String?
  welcomeDashboardEnabled       Boolean                 @default(true)
  welcomeDiscordEnabled         Boolean                 @default(false)
  welcomeMessageTemplate        String?
  welcomeMentionRoleId          String?
  missionValidationChannelId    String?
  missionValidationNotifyRoleId String?
  welcomeBadgeName              String                  @default("Nouveau")
  welcomeDiscordMessageTemplate String?
  chatBlocklist                 Json                    @default("[]")
  chatMotd                      String?
  chatMentionRules              Json                    @default("{}")
  achievementSubmissions        AchievementSubmission[]
  auditLogs                     AuditLog[]
  djSearchPosts                 DjSearchPost[]
  guildActivities               GuildActivity[]
  guildBonuses                  GuildBonus[]
  guildEvents                   GuildEvent[]
  guildLoans                    GuildLoan[]
  modules                       GuildModules?
  welcomePosts                  MemberWelcome[]
  missions                      Mission[]
  ocreTradeRequests             OcreTradeRequest[]
  polls                         Poll[]
  serviceActivityLogs           ServiceActivityLog[]
  serviceListings               ServiceListing[]
  sigilRoles                    SigilRole[]
  profiles                      UserProfile[]
  vaultEntries                  VaultEntry[]
}

model GuildModules {
  id           String      @id @default(cuid())
  guildId      String      @unique
  songes       Boolean     @default(true)
  missions     Boolean     @default(true)
  ocre         Boolean     @default(true)
  calendar     Boolean     @default(true)
  ladder       Boolean     @default(true)
  docs         Boolean     @default(true)
  updatedAt    DateTime    @updatedAt
  updatedBy    String?
  donjons      Boolean     @default(true)
  logs         Boolean     @default(true)
  presentation Boolean     @default(true)
  profile      Boolean     @default(true)
  roster       Boolean     @default(true)
  services     Boolean     @default(true)
  stats        Boolean     @default(true)
  polls        Boolean     @default(true)
  admin        Boolean     @default(true)
  quests       Boolean     @default(false)
  resources    Boolean     @default(false)
  worldmap     Boolean     @default(false)
  chat         Boolean     @default(false)
  guild        GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String      @id @default(cuid())
  guildId     String
  actorUserId String
  actorName   String
  action      String
  targetType  String
  targetId    String?
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  createdAt   DateTime    @default(now())
  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model GuildActivity {
  id         String      @id @default(cuid())
  guildId    String
  type       String
  actorName  String
  actorImage String?
  meta       Json?
  createdAt  DateTime    @default(now())
  guild      GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

model UserProfile {
  id                      String                   @id @default(cuid())
  userId                  String
  guildId                 String
  status                  ProfileStatus            @default(ACTIVE)
  pseudoDofus             String?
  classe                  String?
  metiers                 Json?
  succes                  Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  achievementLastSync     DateTime?
  achievementPoints       Int?
  altPseudos              Json?
  archiveReason           String?
  archivedAt              DateTime?
  availability            Json?
  classeSecondaires       Json?
  discordCacheUpdatedAt   DateTime?
  discordJoinedAt         DateTime?
  discordNickname         String?
  discordRoleColor        Int?
  discordRoleName         String?
  dofusBookLinks          Json?
  dofusPseudo             String?
  entraidePoints          Int                      @default(0)
  fmPriceClassic          Int?
  fmPriceExo              Int?
  fmPriceTrans            Int?
  forgemagieStatus        String?                  @default("UNAVAILABLE")
  guildatons              Int                      @default(0)
  lastActivityAt          DateTime?
  lastActivityDesc        String?
  lastLadderUpdate        DateTime?
  metamobLastSync         DateTime?
  metamobPseudo           String?
  metamobVerified         Boolean                  @default(false)
  successPoints           Int?                     @default(0)
  vacationEnd             DateTime?
  vacationNotify          Boolean                  @default(false)
  vacationStart           DateTime?
  xp                      Int                      @default(0)
  metamobQuestSlug        String?
  metamobServerId         Int?
  metamobApiKey           String?
  contributionPoints      Int                      @default(0)
  scheduledDeletion       DateTime?
  notificationPrefs       Json?
  hasSeenWelcome          Boolean                  @default(false)
  introduction            String?
  achievementSubmissions  AchievementSubmission[]
  djParticipations        DjSearchParticipant[]
  djSearchPosts           DjSearchPost[]
  guildBonuses            GuildBonus[]
  loansReceived           GuildLoan[]              @relation("LoansReceived")
  loansGiven              GuildLoan[]              @relation("LoansGiven")
  givenCredits            HelpCredit[]             @relation("GivenCredits")
  receivedCredits         HelpCredit[]             @relation("ReceivedCredits")
  welcomePosts            MemberWelcome[]
  interests               MissionInterest[]
  sentOcreRequests        OcreTradeRequest[]       @relation("Requester")
  receivedOcreRequests    OcreTradeRequest[]       @relation("Target")
  polls                   Poll[]                   @relation("PollCreator")
  pollVotes               PollVote[]
  serviceActivityLogs     ServiceActivityLog[]
  serviceListings         ServiceListing[]
  roleGrants              SigilRoleGrant[]
  submissions             Submission[]
  userDungeonAchievements UserDungeonAchievement[]
  dungeonProgress         UserDungeonProgress[]
  lastSeen                DateTime?                @default(now())
  isInGame                Boolean                  @default(false)
  showPresence            Boolean                  @default(true)
  guild                   GuildConfig              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultEntries            VaultEntry[]
  helpedSubmissions       Submission[]             @relation("SubmissionHelpers")

  @@unique([userId, guildId])
  @@index([guildId])
  @@index([userId])
}

model Mission {
  id               String            @id @default(cuid())
  guildId          String
  category         MissionCategory
  status           MissionStatus     @default(ACTIVE)
  tier             Int               @default(1)
  xpReward         Int?
  guildatonsReward Int?
  title            String?
  payload          Json
  weekNumber       Int
  year             Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  slotIndex        Int               @default(0)
  rank             Int               @default(1)
  guild            GuildConfig       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  interests        MissionInterest[]
  submissions      Submission[]

  @@unique([guildId, weekNumber, year, slotIndex])
  @@index([guildId, weekNumber, year])
}

model MissionInterest {
  id        String      @id @default(cuid())
  missionId String
  profileId String
  createdAt DateTime    @default(now())
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([missionId, profileId])
  @@index([profileId])
}

model Submission {
  id               String           @id @default(cuid())
  missionId        String
  profileId        String
  status           SubmissionStatus @default(PENDING)
  proofUrl         String
  validatorId      String?
  discordMessageId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ocrResult        Json?
  ocrScore         Float?
  ocrStatus        OcrStatus        @default(PENDING)
  mission     Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile     UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  helpers     UserProfile[]    @relation("SubmissionHelpers")

  @@unique([missionId, profileId])
  @@index([missionId])
  @@index([profileId])
  @@index([status, updatedAt])
}

model AchievementSubmission {
  id          String           @id @default(cuid())
  profileId   String
  guildId     String
  status      SubmissionStatus @default(PENDING)
  points      Int
  proofUrl    String
  ocrScore    Float?
  ocrRawText  String?
  validatorId String?
  validatedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  guild       GuildConfig      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile     UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([profileId])
}

model Dungeon {
  id                  String                @id @default(cuid())
  name                String
  bossName            String
  level               Int
  dpnlUrl             String?
  imageUrl            String?
  createdAt           DateTime              @default(now())
  expeditionMechanics String?
  expeditionModes     Json?
  isExpedition        Boolean               @default(false)
  isEventDungeon      Boolean               @default(false)
  updatedAt           DateTime              @updatedAt
  djSearchPosts       DjSearchPost[]
  achievements        DungeonAchievement[]
  userProgress        UserDungeonProgress[]
  zones               Zone[]                @relation("DungeonToZone")

  @@unique([name, bossName])
  @@index([level])
  @@index([isExpedition])
  @@index([isEventDungeon])
}

model Zone {
  id            String          @id @default(cuid())
  name          String          @unique
  level         Int
  dpnlUrl       String?
  isEventZone   Boolean         @default(false)
  eventZoneKey  String?         // VULKANIA | NOWEL | PWAK | HALOUINE
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  dungeons      Dungeon[]       @relation("DungeonToZone")
  families      MonsterFamily[] @relation("MonsterFamilyToZone")

  @@index([name])
  @@index([isEventZone])
}

model Monster {
  id        String        @id @default(cuid())
  name      String
  imageUrl  String?
  createdAt DateTime      @default(now())
  familyId  String
  level     Int?
  updatedAt DateTime      @updatedAt
  family    MonsterFamily @relation(fields: [familyId], references: [id])

  @@index([familyId])
  @@index([name])
}

model MonsterFamily {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  level       Int?
  monsters    Monster[]
  zones       Zone[]    @relation("MonsterFamilyToZone")

  @@index([name])
}

model Challenge {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  description         String?
  iconUrl             String?
  conditions          Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  dungeonAchievements DungeonAchievement[]

  @@index([slug])
  @@index([name])
}

model DungeonAchievement {
  id           String                   @id @default(cuid())
  dungeonId    String
  challengeId  String
  points       Int                      @default(10)
  imageUrl     String?
  createdAt    DateTime                 @default(now())
  challenge    Challenge                @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dungeon      Dungeon                  @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  achievedBy   UserDungeonAchievement[]
  userProgress UserDungeonProgress[]

  @@unique([dungeonId, challengeId])
  @@index([dungeonId])
  @@index([challengeId])
}

model UserDungeonAchievement {
  id                   String             @id @default(cuid())
  userId               String
  dungeonAchievementId String
  completedAt          DateTime           @default(now())
  dungeonAchievement   DungeonAchievement @relation(fields: [dungeonAchievementId], references: [id], onDelete: Cascade)
  user                 UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dungeonAchievementId])
  @@index([userId])
  @@index([dungeonAchievementId])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean              @default(false)
  link      String?
  createdAt DateTime             @default(now())
  category  NotificationCategory @default(SYSTEM)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([userId, read, createdAt])
}

model DreamRun {
  id                  String             @id @default(cuid())
  guildId             String
  leaderId            String
  difficulty          DreamDifficulty
  objective           DreamObjective?    @default(FUN)
  objectives          DreamObjective[]
  status              DreamRunStatus     @default(RECRUITING)
  currentFloor        Int                @default(0)
  pointsReve          Int                @default(0)
  minorBonuses        Json?
  createdAt           DateTime           @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  notifyOnJoinRequest Boolean            @default(true)
  discordChannelId    String?
  discordMessageId    String?
  updatedAt           DateTime           @default(now()) @updatedAt
  lastReminderAt      DateTime?
  epreuveCode         String?
  floors              DreamFloor[]
  joinRequests        DreamJoinRequest[]
  leader              User               @relation("RunLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  bonuses             DreamRunBonus[]
  members             DreamRunMember[]
  reminders           DreamRunReminder[]
  waitlist            DreamWaitlist[]

  @@index([guildId, status])
  @@index([leaderId, status])
}

model DreamRunMember {
  id       String   @id @default(cuid())
  runId    String
  userId   String
  slot     Int
  joinedAt DateTime @default(now())
  run      DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@unique([runId, slot])
}

model DreamWaitlist {
  id        String   @id @default(cuid())
  runId     String
  userId    String
  position  Int
  createdAt DateTime @default(now())
  run       DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([runId, position])
}

model DreamFloor {
  id               String        @id @default(cuid())
  runId            String
  floorNumber      Int
  roomType         DreamRoomType
  difficulty       Int?
  pointsReveGained Int           @default(0)
  completedAt      DateTime      @default(now())
  run              DreamRun      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, floorNumber])
}

model DreamRunBonus {
  id          String   @id @default(cuid())
  runId       String
  bonusName   String
  bonusType   String
  bonusRarete String
  cost        Int
  acquiredAt  DateTime @default(now())
  run         DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model DreamJoinRequest {
  id               String            @id @default(cuid())
  runId            String
  userId           String
  classe           String
  message          String?
  status           JoinRequestStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  respondedAt      DateTime?
  discordChannelId String?
  discordMessageId String?
  run              DreamRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([runId, status])
  @@index([userId])
}

model DreamRunReminder {
  id               String   @id @default(cuid())
  runId            String
  discordMessageId String
  discordChannelId String
  createdAt        DateTime @default(now())
  run              DreamRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model GuildEvent {
  id               String             @id @default(cuid())
  guildId          String
  creatorId        String
  title            String
  description      String?
  type             GuildEventType     @default(SOCIAL)
  status           EventStatus        @default(DRAFT)
  startDate        DateTime
  endDate          DateTime
  recurrence       RecurrenceType     @default(UNIQUE)
  parentEventId    String?
  location         String?
  maxParticipants  Int?
  discordMessageId String?
  discordChannelId String?
  metadata         Json?
  notifyBefore     Int?               @default(60)
  lastRemindedAt   DateTime?
  proofUrl         String?
  validatedAt      DateTime?
  validatedBy      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  participants     EventParticipant[]
  creator          User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  guild            GuildConfig        @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, startDate])
  @@index([guildId, status])
  @@index([creatorId])
}

model EventParticipant {
  id          String            @id @default(cuid())
  eventId     String
  userId      String
  status      ParticipantStatus @default(REGISTERED)
  position    Int
  classe      String?
  comment     String?
  promotedAt  DateTime?
  confirmedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  event       GuildEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, position])
}

model ImageHash {
  id         String   @id @default(cuid())
  guildId    String
  hash       String
  sourceType String
  sourceId   String
  uploaderId String
  createdAt  DateTime @default(now())

  @@unique([guildId, hash])
  @@index([guildId])
  @@index([hash])
  @@index([uploaderId])
}

model HelpCredit {
  id          String      @id @default(cuid())
  guildId     String
  fromUserId  String
  toUserId    String
  missionId   String?
  message     String?
  points      Int         @default(5)
  createdAt   DateTime    @default(now())
  fromProfile UserProfile @relation("GivenCredits", fields: [fromUserId, guildId], references: [userId, guildId], onDelete: Cascade)
  toProfile   UserProfile @relation("ReceivedCredits", fields: [toUserId, guildId], references: [userId, guildId], onDelete: Cascade)

  @@index([guildId, toUserId])
  @@index([guildId, fromUserId])
  @@index([guildId, fromUserId, createdAt])
}

model OcrApiUsage {
  id        String   @id @default(cuid())
  date      DateTime @default(now()) @db.Date
  endpoint  String
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, endpoint])
  @@index([date])
}

model OcreTradeRequest {
  id          String      @id @default(cuid())
  guildId     String
  requesterId String
  targetId    String
  monsterId   Int
  status      TradeStatus @default(PENDING)
  message     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  requester   UserProfile @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      UserProfile @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([targetId, status])
  @@index([requesterId, status])
}

model GuildBonus {
  id                    String       @id @default(cuid())
  guildId               String
  bonusType             BonusType
  cost                  Int
  status                BonusStatus  @default(PURCHASED)
  purchasedAt           DateTime     @default(now())
  purchasedBy           String?
  activatesAt           DateTime
  expiresAt             DateTime?
  notificationChannelId String?
  notificationMessageId String?
  mentionType           MentionType  @default(NONE)
  mentionRoleId         String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  guild                 GuildConfig  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  purchaser             UserProfile? @relation(fields: [purchasedBy], references: [id])

  @@index([guildId, status])
  @@index([activatesAt])
}

model DocPage {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  content     String
  category    String
  order       Int            @default(0)
  isPublished Boolean        @default(true)
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())
  accessLevel DocAccessLevel @default(PUBLIC)
  guildId     String?

  @@index([category, order])
  @@index([slug])
  @@index([guildId, accessLevel])
}

model ChangelogEntry {
  id          String            @id @default(cuid())
  version     String
  title       String
  content     String
  category    ChangelogCategory
  publishedAt DateTime          @default(now())
  publishedBy String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  summary     String?
  isInternal  Boolean           @default(false)

  @@index([publishedAt])
  @@index([category])
}

model SigilRole {
  id          String           @id @default(cuid())
  guildId     String
  slug        String
  label       String
  description String?
  color       String?
  icon        String?
  permissions String[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  guild       GuildConfig      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  grants      SigilRoleGrant[]

  @@unique([guildId, slug])
  @@index([guildId])
}

model SigilRoleGrant {
  id        String      @id @default(cuid())
  roleId    String
  profileId String
  grantedBy String
  grantedAt DateTime    @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      SigilRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, profileId])
  @@index([profileId])
  @@index([expiresAt])
}

model Poll {
  id                 String       @id @default(cuid())
  guildId            String
  title              String
  description        String?
  category           PollCategory
  status             PollStatus   @default(DRAFT)
  creatorId          String
  creatorName        String
  allowMultipleVotes Boolean      @default(false)
  isAnonymous        Boolean      @default(false)
  discordMessageId   String?
  discordChannelId   String?
  mentionEveryone    Boolean      @default(false)
  mentionRoleId      String?
  expiresAt          DateTime?
  closedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  outcome            String?
  creator            UserProfile  @relation("PollCreator", fields: [creatorId], references: [id])
  guild              GuildConfig  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  options            PollOption[]

  @@index([guildId, status])
  @@index([expiresAt])
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  label  String
  order  Int        @default(0)
  emoji  String?
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String      @id @default(cuid())
  optionId  String
  voterId   String
  createdAt DateTime    @default(now())
  option    PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voter     UserProfile @relation(fields: [voterId], references: [id])

  @@unique([optionId, voterId])
  @@index([optionId])
  @@index([voterId])
}

model DjSearchPost {
  id                   String                @id @default(cuid())
  guildId              String
  profileId            String
  dungeonId            String?
  mode                 DjSearchMode          @default(DONJON)
  wantedAchievementIds String[]
  maxMembers           Int                   @default(4)
  questName            String?
  questUrl             String?
  message              String?
  targetDate           DateTime?
  status               DjSearchStatus        @default(OPEN)
  discordMessageId     String?
  discordChannelId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  closedAt             DateTime?
  expiresAt            DateTime
  isDiscordPublished   Boolean               @default(false)
  questId              Int?
  requiredClasses      String[]
  participants         DjSearchParticipant[]
  dungeon              Dungeon?              @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  guild                GuildConfig           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile              UserProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, status, createdAt])
  @@index([profileId])
  @@index([dungeonId])
  @@index([expiresAt])
}

model DjSearchParticipant {
  id          String              @id @default(cuid())
  postId      String
  profileId   String
  userId      String
  classe      String?
  message     String?
  status      DjParticipantStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  post        DjSearchPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile     UserProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([postId, status])
  @@index([profileId])
}

model UserDungeonProgress {
  id            String             @id @default(cuid())
  profileId     String
  dungeonId     String
  achievementId String
  completedAt   DateTime           @default(now())
  achievement   DungeonAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  dungeon       Dungeon            @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  profile       UserProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, achievementId])
  @@index([profileId])
  @@index([dungeonId])
  @@index([achievementId])
}

model DreamBonus {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   @default("ACTIF")
  description String?
  imageUrl    String?
  costMin     Int?
  costMax     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model GameQuest {
  id          String   @id @default(cuid())
  name        String   @unique
  dofusDbId   Int?
  levelMin    Int?
  levelMax    Int?
  description String?
  imageUrl    String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model ServiceListing {
  id                       String          @id @default(cuid())
  guildId                  String
  profileId                String
  category                 ServiceCategory
  status                   ServiceStatus   @default(ACTIVE)
  title                    String
  description              String?
  price                    String?
  availability             String?
  discordMessageId         String?
  discordChannelId         String?
  contactMethod            String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  craftMeta                Json?
  dofusItemAnkamaId        Int?
  dofusItemIconUrl         String?
  dofusItemName            String?
  dungeonId                String?
  dungeonName              String?
  priceTiers               Json?
  professions              Json?
  questId                  String?
  questName                String?
  selectedAchievements     Json?
  dungeonImageUrl          String?
  selectedAchievementNames Json?
  guild                    GuildConfig     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile                  UserProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([guildId, category])
  @@index([profileId])
}

model GuildLoan {
  id                String      @id @default(cuid())
  guildId           String
  lenderId          String
  borrowerId        String
  type              LoanType
  status            LoanStatus  @default(ACTIVE)
  description       String
  amount            String?
  proofUrl          String?
  returnProofUrl    String?
  lentAt            DateTime    @default(now())
  dueDate           DateTime?
  returnedAt        DateTime?
  notes             String?
  linkedItemIconUrl String?
  linkedItemName    String?
  borrower          UserProfile @relation("LoansReceived", fields: [borrowerId], references: [id], onDelete: Cascade)
  guild             GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  lender            UserProfile @relation("LoansGiven", fields: [lenderId], references: [id], onDelete: Cascade)

  @@index([guildId, status])
  @@index([lenderId])
  @@index([borrowerId])
}

model VaultEntry {
  id                String      @id @default(cuid())
  guildId           String
  profileId         String
  action            VaultAction
  itemName          String
  quantity          Int?        @default(1)
  description       String?
  proofUrl          String?
  createdAt         DateTime    @default(now())
  linkedItemIconUrl String?
  guild             GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([profileId])
}

model ServiceActivityLog {
  id        String      @id @default(cuid())
  guildId   String
  actorId   String
  module    String
  action    String
  entityId  String
  summary   String
  details   String?
  metadata  String?
  createdAt DateTime    @default(now())
  actor     UserProfile @relation(fields: [actorId], references: [id], onDelete: Cascade)
  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, module, createdAt])
  @@index([entityId])
  @@index([actorId])
}

model MemberWelcome {
  id        String      @id @default(cuid())
  guildId   String
  profileId String
  content   String
  reactions Json?
  createdAt DateTime    @default(now())
  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

