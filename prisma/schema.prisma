model Dungeon {
  id                   String                @id @default(cuid())
  name                 String
  bossName             String
  /// Segment d'URL publique (`/boss/<slug>`) : généré depuis `bossName`, stable
  /// dans le temps (une fois publié, on ne le change plus — sinon 308 depuis
  /// l'ancien slug ET l'ancien identifiant, cf. src/app/boss/[dungeonId]/page.tsx).
  slug                 String                @unique
  level                Int
  dpnlUrl              String?
  dofuspourlesnoobsUrl String?
  dofensiveUrl         String?
  imageUrl             String?
  createdAt            DateTime              @default(now())
  expeditionMechanics  String?
  expeditionModes      Json?
  isExpedition         Boolean               @default(false)
  updatedAt            DateTime              @updatedAt
  isEventDungeon       Boolean               @default(false)
  isOcreQuest          Boolean               @default(false) // Donjon de la Quête Ocre (Éternelle Moisson)
  dofusdbId            Int?                  // Identifiant DofusDB pour croisement avec les données du jeu
  mapId                Int?                  // Identifiant map worldmap.json pour l'icône sur la carte
  // Chantier double boss — dissociation affichage / résolution Dofensive.
  // `dofensiveMonsterName` = nom EXACT du monstre Dofensive (ex. "Sylargh") pour retrouver la map « Balcon de … » ;
  // `dofensiveDungeonName` = nom EXACT du donjon Dofensive (ex. "Donjon du Comte Harebourg") pour lever l'ambiguïté
  // avec les donjons solo homonymes (Sylargh existe aussi en donjon seul). Vides pour un donjon classique.
  dofensiveMonsterName String?
  dofensiveDungeonName String?
  /* donjon sans succès : le « succès » est d'être validé → un pseudo-succès « Donjon validé » est créé. */
  isNoAchievement      Boolean               @default(false) // Donjon sans succès (validable en un clic)
  /* Chantier « boss d'anomalie » (Gardiens des anomalies temporelles) — contenu SIPHONNÉ
     (Dofensive `/monsters/{id}` + DofusDB `monsters?race=191`), jamais saisi à la main.
     `anomalyMapId`  = map de combat Dofensive du gardien (map par défaut si le gardien n'est
                       pas exposé par Dofensive, ex. Qilby) ;
     `anomalyFamily` = libellé de famille affiché (« Créatures des Anomalies Temporelles »). */
  isAnomalyBoss        Boolean               @default(false) // Boss d'anomalie temporelle (Gardiens des anomalies)
  anomalyMapId         Int?                  // Map de combat Dofensive (résolue par le siphon)
  anomalyFamily        String?               // Famille/race Dofensive du gardien (affichage)
  djSearchPosts        DjSearchPost[]
  achievements         DungeonAchievement[]
  userProgress         UserDungeonProgress[]
  zones                Zone[]                @relation("DungeonToZone")
  milestoneSequences   GuideSequence[]       // Donjons référencés dans les séquences du guide

  @@unique([name, bossName])
  @@index([level])
  @@index([isExpedition])
  @@index([isEventDungeon])
  @@index([isAnomalyBoss])
  @@index([dofusdbId])
}

