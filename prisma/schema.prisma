   */
  dungeonIndex Int?
  status      DjParticipantStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  post        DjSearchPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile     UserProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@index([postId, status])
  @@index([profileId])
}

model UserDungeonProgress {
  id            String             @id @default(cuid())
  profileId     String
  dungeonId     String
  achievementId String
  completedAt   DateTime           @default(now())
  /**
   * #138 — provenance de la validation :
   *  - "MANUAL" : cochée par le membre dans « Mes Succès » (interface classique)
   *  - "GROUP"  : validée à la clôture d'un post DJ/Quête (tout le groupe présent)
   *  Sert à la notification « tes succès ont été mis à jour » côté participant.
   */
  source        String             @default("MANUAL")
  achievement   DungeonAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  dungeon       Dungeon            @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  profile       UserProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, achievementId])
  @@index([profileId])
  @@index([dungeonId])
  @@index([achievementId])
}

/// Défi (événement / combat one-shot, ex. « Défi du Xélor fou », « Faille inattendue »).
/// Un défi référence un ou plusieurs boss (noms + ids Dofensive optionnels), une zone, une image.
/// Côté membre : l'onglet « Défi » de /succes permet de cocher « je l'ai fait » et « qui a quoi ».
model Defi {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  zone         String?
  level        Int?
  imageUrl     String?
  dofensiveUrl String?
  dpnlUrl      String?
  dofuspourlesnoobsUrl String?
  /// Boss du défi + infos pour l'affichage / la fiche : [{ name, dofusdbId?, imageUrl? }]
  bossNames    Json?    @default("[]")
  /// Fenêtre d'événement. Si `isPermanent` = true, le défi est dispo en permanence sur le jeu
  /// (startDate/endDate ignorés) ; sinon `startDate` (début) et `endDate` (fin) bornent l'événement.
  isPermanent  Boolean  @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userProgress UserDefiProgress[]
  djPosts     DjSearchPost[]

  @@index([name])
  @@index([zone])
  @@index([level])
}

/// Progression « je l'ai fait » sur un défi (par membre).
model UserDefiProgress {
  id          String   @id @default(cuid())
  profileId   String
  defiId      String
  source      String   @default("MANUAL") // MANUAL | GROUP
  completedAt DateTime @default(now())
  defi        Defi     @relation(fields: [defiId], references: [id], onDelete: Cascade)
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, defiId])
  @@index([profileId])
  @@index([defiId])
}

/// Titan (Événement Krosmique, ex. Gargandyas) — boss de week-end, contenu ÉVOLUTIF.
/// Chaque Titan porte SA PROPRE config de disponibilité (jours/créneaux/maxVictoires), ce qui
/// permet d'ajouter de futurs Titans avec des contraintes différentes sans figer le modèle.
model Titan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  level         Int      @default(200)
  description   String?
  zone          String?                    // Dimension / zone (ex. Osavora) — libellé libre
  imageUrl      String?
  dpnlUrl       String?
  dofensiveUrl  String?
  dofuspourlesnoobsUrl String?
  mapName       String?                    // Nom de la map isométrique à télécharger (ex. « Temple de Gargandyas — Salle du Graogarm »)
  dofusdbId     Int?                       // ID DofusDB du monstre/boss titan (ex. 8062 pour Gargandyas)
  questName     String?                    // Quête associée au titan (ex. « Destructeur de mondes »)
  questUrl      String?                    // Lien vers la quête (DofusDB / DofusPourLesNoobs)
  /// Config de disponibilité FLEXIBLE (ne PAS figer les contraintes horaires/jours) :
  ///  { daysOfWeek?: number[], startTime?: "19:00", endTime?: "08:00", maxWinsPerWeekend?: 5, onlyWeekend?: true }
  scheduleConfig Json?  @default("{}")
  /// Mapping du boss de phase 4 par saison : [{ season, bossName, imageUrl? }]
  seasonBosses  Json?    @default("[]")
  seasons       String[] @default([])       // Libellés des saisons connues (ex. "Naissances", "Chasse", "Repos")
  currentSeason String?                     // Saison en cours (affichage « saison en cours »)
  maxMembers    Int      @default(4)        // 4 personnes maximum (limitation)
  isPermanent   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProgress  UserTitanProgress[]
  djPosts       DjSearchPost[]

  @@index([name])
  @@index([zone])
  @@index([level])
}

/// Progression « je l'ai vaincu » sur un titan (par membre).
model UserTitanProgress {
  id          String   @id @default(cuid())
  profileId   String
  titanId     String
  source      String   @default("MANUAL") // MANUAL | GROUP
  completedAt DateTime @default(now())
  titan       Titan    @relation(fields: [titanId], references: [id], onDelete: Cascade)
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, titanId])
  @@index([profileId])
  @@index([titanId])
}

/// 🏅 #198.2 — Système de Badges & Succès Plateforme SigilOS
model Badge {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  description     String?
  imageUrl        String
  rarity          String      @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY | MYTHIC
  category        String      @default("COMMUNITY") // COMMUNITY | GAMEPLAY | EVENT | STAFF | GUILD
  isSecret        Boolean     @default(false)
  isGodOnly       Boolean     @default(false)
  sortOrder       Int         @default(0)
  /// Déclencheur automatique (#198.2 No-Code Rules Engine)
  triggerType     String      @default("MANUAL") // MANUAL | KOFI_DONATION | DOFUS_SPECIFIC | DOFUS_COUNT | DEFI_COUNT | SONGES_FLOOR | MISSIONS_COUNT
  triggerValue    String?     // ex: "5", "200", "dofus-ocre"
  triggerMetadata Json?
