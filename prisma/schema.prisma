  createdAt DateTime    @default(now())
  admin     User        @relation("RelanceAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([adminId])
}

model BuildVote {
  id        String   @id @default(cuid())
  buildId   String
  userId    String
  guildId   String
  createdAt DateTime @default(now())

  @@unique([buildId, userId])
  @@index([buildId])
  @@index([guildId])
}

/// Représente un Dofus (les 23 Dofus du jeu — assets dans /public/module-dofus/)
model DofusItem {
  id                String                @id @default(cuid())
  slug              String                @unique
  name              String
  nameShort         String
  element           String?
  rarity            String                @default("MAJEUR")
  isPrimordial      Boolean               @default(false)
  levelRecommended  Int                   @default(1)
  imageUrl          String?
  color             String?
  displayOrder      Int                   @default(0)
  description       String?
  successName       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  filterCategory    String                @default("AUTRES")
  filterSubCategory String?
  localImageUrl     String?
  bonusSummary      String?
  isMeta            Boolean               @default(false)
  isSylvestreReq    Boolean               @default(false)
  questChains       DofusQuestChain[]
  requirementsFrom  DofusRequirement[]    @relation("RequirementSource")
  requirementsTo    DofusRequirement[]    @relation("RequirementTarget")
  playerProgress    PlayerDofusProgress[]

  @@index([slug])
  @@index([displayOrder])
  @@index([isSylvestreReq])
}

/// Une "section" de quêtes pour un Dofus (Prérequis, Quêtes principales, etc.)
model DofusQuestChain {
  id            String            @id @default(cuid())
  dofusId       String
  sectionType   String
  sectionName   String
  description   String?
  chainOrder    Int               @default(0)
  coordinatesV3 Json?
  dofus         DofusItem         @relation(fields: [dofusId], references: [id], onDelete: Cascade)
  entries       DofusQuestEntry[]

  @@index([dofusId])
  @@index([dofusId, chainOrder])
}

/// Une quête individuelle dans une chaîne Dofus
model DofusQuestEntry {
  id                 String                     @id @default(cuid())
  chainId            String
  name               String
  zone               String?
  questType          String                     @default("QUEST")
  stepOrder          Int                        @default(0)
  isOptional         Boolean                    @default(false)
  isLast             Boolean                    @default(false)
  dofusdbId          Int?
  requirements       Json?
  notes              String?
  coords             Json?
  mapId              Int?
  posX               Int                        @default(0)
  posY               Int                        @default(0)
  isDungeon          Boolean                    @default(false)
  itemsRequired      Json?
  level              Int?
  npcSubArea         String?
  objectives         Json?
  npcName            String?
  isSynergyCandidate Boolean                    @default(false)
  coordinatesV3      Json?
  localImageUrl      String?
  externalRef        String?
  weight             Int                        @default(1)
  dungeonsRequired   Json?
  chain              DofusQuestChain            @relation(fields: [chainId], references: [id], onDelete: Cascade)
  playerProgress     PlayerDofusQuestProgress[]

  @@index([chainId])
  @@index([chainId, stepOrder])
}

/// Progression d'un joueur sur un Dofus spécifique (obtenu ou non)
model PlayerDofusProgress {
  id                String      @id @default(cuid())
  profileId         String
  guildId           String
  dofusId           String
  isObtained        Boolean     @default(false)
  obtainedAt        DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  completionPercent Int         @default(0)
  characterName     String      @default("PRINCIPAL")
  dofus             DofusItem   @relation(fields: [dofusId], references: [id], onDelete: Cascade)
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dofusId, characterName])
  @@index([guildId])
  @@index([profileId])
  @@index([dofusId])
  @@index([characterName])
}

/// V3: Lien de dépendance entre Dofus (ex: Sylvestre → Dom de Pin → Ocre)
model DofusRequirement {
  id          String    @id @default(cuid())
  fromDofusId String
  toDofusId   String
  notes       String?
  createdAt   DateTime  @default(now())
  fromDofus   DofusItem @relation("RequirementSource", fields: [fromDofusId], references: [id], onDelete: Cascade)
  toDofus     DofusItem @relation("RequirementTarget", fields: [toDofusId], references: [id], onDelete: Cascade)

  @@unique([fromDofusId, toDofusId])
  @@index([fromDofusId])
  @@index([toDofusId])
}

/// Progression d'un joueur sur une quête spécifique dans une chaîne Dofus
model PlayerDofusQuestProgress {
  id            String           @id @default(cuid())
  profileId     String
  guildId       String
  questId       String
  status        DofusQuestStatus @default(NOT_STARTED)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  characterName String           @default("PRINCIPAL")
  profile       UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  quest         DofusQuestEntry  @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([profileId, questId, characterName])
  @@index([guildId])
  @@index([profileId])
  @@index([questId])
  @@index([characterName])
}

model GuildatonRecord {
  id        String      @id @default(cuid())
  guildId   String
  discordId String
  username  String?
  ankamaId  String?
  value     Int         @default(0)
  updatedAt DateTime    @updatedAt
  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId])
  @@index([guildId])
}

model GuildatonHistory {
  id        String      @id @default(cuid())
  guildId   String
  discordId String
  value     Int
  createdAt DateTime    @default(now())
  guild     GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, discordId])
  @@index([createdAt])
}

// ─── Guide Optimisé — Arbre de Progression ───────────────────────────────────

model OptimizedGuide {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String?
  imageUrl            String?
  isActive            Boolean              @default(false)
  isUnderConstruction Boolean              @default(false) // God toggle: affiche "En construction" côté membres
  displayMode         String               @default("TREE") // "TREE" | "TIMELINE" — mode d'affichage membre
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  steps               OptimizedGuideStep[]
  milestones          GuideMilestone[]
}

model OptimizedGuideStep {
  id          String         @id @default(cuid())
  guideId     String
  order       Int
  title       String
  description String?
  questIds    String[]
  customTasks Json?          @default("[]")
  objectives  Json?          @default("[]")
  guide       OptimizedGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
  @@index([guideId, order])
}

// Noeud de l'arbre de progression : représente un objectif majeur du jeu
// (ex: Dofus Argenté, Alignement, Tour du Monde...)
model GuideMilestone {
  id              String               @id @default(cuid())
  guideId         String
  type            GuideMilestoneType
  title           String               // ex: "Dofus Argenté"
  subtitle        String?              // ex: "Compléter Incarnam & Astrub"
  description     String?              // Texte de présentation affiché dans le panneau
  chapter         Int                  // Regroupement visuel (1 à 7)
  chapterLabel    String               // ex: "Chapitre 1 — Premiers Pas"
  imageUrl        String?              // Image du récompense (item DofusDB)
  accentColor     String?              // Couleur hex du noeud sur l'arbre
  posX            Float                @default(0) // Position X dans le canvas
  posY            Float                @default(0) // Position Y dans le canvas
  isOptional      Boolean              @default(false)
  prerequisiteIds String[]             @default([]) // IDs de milestones requis avant celui-ci
  order           Int                  @default(0)  // Ordre global pour le tri
  tips            String?              // Conseils / astuces au niveau du bloc
  dofusId         String?              // Association optionnelle avec un DofusItem (pour le % global)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  guide           OptimizedGuide       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  sequences       GuideSequence[]      // Étapes ordonnées à réaliser pour atteindre ce milestone
  playerProgress  PlayerGuideProgress[]

  @@index([guideId])
  @@index([guideId, chapter, order])
  @@index([type])
}

// Une séquence = un bloc de travail dans un sous-guide à réaliser
// pour atteindre le milestone parent
// ex: "Faire les étapes 1 à 25 de [GP1] Incarnam & Astrub"
model GuideSequence {
  id          String   @id @default(cuid())
  milestoneId String
  order       Int      // Ordre d'exécution dans la séquence

  // Identification du sous-guide source
  subGuideRef  String   // Code interne du sous-guide (ex: "GP1", "GP2")
  subGuideName String   // Nom de la quête / étape
  stepFrom     Int?     // Étape de départ dans le sous-guide
  stepTo       Int?     // Étape de fin dans le sous-guide
  isPartial    Boolean  @default(true)  // true = portion du guide, false = guide entier
  isOptional   Boolean  @default(false)
  note         String?  // Avertissement ou conseil (ex: "Ne pas cliquer le Portail !")
  isResume     Boolean  @default(false) // true = on reprend après interruption

  // Liens personnalisés dofusdb / dofusnoob déclarés par le super-admin
  dofusdbUrl           String?
  dofuspourlesnoobsUrl String?
  tips                 String?  // Conseils spécifiques à cette quête
  
  // Alignement optionnel lié à cette quête (ex: "bontarien", "brakmarien") + niveau d'ordre
  alignReq             String?  // "bontarien" | "brakmarien"
  alignOrderReq        Int?     // Niveau requis (1 à 100)

  // Donjons requis (Plusieurs IDs stockés dans un tableau JSON ou de chaînes)
  dungeonIds   String[] @default([]) // Liste d'IDs de Dungeon pour supporter plusieurs donjons à la fois

  // Lien historique vers un donjon principal
  dungeonId    String?
  dungeon      Dungeon? @relation(fields: [dungeonId], references: [id], onDelete: SetNull)

  // Métadonnées de jeu extraites du guide
  // Donjons à faire (dofusdbIds), quêtes associées (dofusdbIds)
  dungeonDbIds Int[]    @default([])   // dofusdbId des donjons concernés
  questDbIds   Int[]    @default([])   // dofusdbId des quêtes concernées
  mapPositions Json?    @default("[]") // Positions cliquables [{x, y, label}]

  // Types spéciaux d'étapes
  isSuccess         Boolean  @default(false)  // true = étape de succès (icône trophée)
  metamobMonsterId  Int?                       // ID du monstre Metamob lié (Ocre / Quête Éternelle Moisson)
  activityTags      Json     @default("[]")   // Tags d'activité : [{ type: string, name?: string, level?: number }]

  createdAt   DateTime      @default(now())
  milestone   GuideMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([milestoneId, order])
  @@index([dungeonId])
}

// Progression d'un membre sur un milestone donné
model PlayerGuideProgress {
  id          String         @id @default(cuid())
  profileId   String
  milestoneId String
  isCompleted Boolean        @default(false)
  completedAt DateTime?
  completedSteps Json?       @default("[]")
  currentStep String?        // Active/bookmarked step key (e.g., "GP1-5")
  notes       String?        // Note personnelle du membre
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  profile     UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  milestone   GuideMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([profileId, milestoneId])
  @@index([profileId])
  @@index([milestoneId])
}

enum GuideMilestoneType {
  DOFUS         // Obtention d'un Dofus
  ZONE          // Débloquer une zone/région
  DONJON        // Compléter un donjon clé
  QUETE_SERIE   // Série de quêtes majeures
  ALIGNEMENT    // Progression d'alignement
  PREREQUIS     // Prérequis technique (non visible dans l'arbre principal)
  SUCCES        // Succès spécifique
}

// Stocke le JSON complet d'un sous-guide Ganymède (GP1, GP2, etc.)
// Permet d'afficher les étapes détaillées quand un membre consulte une séquence
model SubGuideData {
  id          String   @id @default(cuid())
  guideRef    String   @unique // "GP1", "GP2", "GP3"... Clé de lookup
  ganymadeId  Int      @unique // ID numérique sur ganymede-app.com
  guideName   String           // "[GP1] Incarnam & Astrub"
  totalSteps  Int      @default(0)
  steps       Json             // Array of { id, stepNumber, web_text, pos_x, pos_y }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guideRef])
}

