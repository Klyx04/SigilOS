generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                   String             @id @default(cuid())
  name                 String?
  email                String?            @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  deletionRequestedAt  DateTime?
  emailBackup          String?
  scheduledDeletion    DateTime?
  lastSeenChangelogId  String?
  lastFeedViewedAt     DateTime?          @default(now())
  accounts             Account[]
  dreamJoinRequests    DreamJoinRequest[]
  dreamRuns            DreamRun[]         @relation("RunLeader")
  dreamRunMembers      DreamRunMember[]
  dreamWaitlists       DreamWaitlist[]
  eventParticipations  EventParticipant[]

  guildEvents          GuildEvent[]
  notifications        Notification[]
  administeredRelances Relance[]          @relation("RelanceAdmin")
  sessions             Session[]
  profiles             UserProfile[]
}

model AllowedGuild {
  id             String    @id @default(cuid())
  discordGuildId String    @unique
  name           String?
  tier           String    @default("BETA")
  isActive       Boolean   @default(true)
  addedBy        String
  addedAt        DateTime  @default(now())
  expiresAt      DateTime?
  notes          String?

  @@index([discordGuildId])
  @@index([isActive])
}

model PlatformBan {
  id         String   @id @default(cuid())
  entityType String
  discordId  String   @unique
  reason     String
  bannedBy   String
  createdAt  DateTime @default(now())

  @@index([discordId])
  @@index([entityType])
}

// Tombstone guild-scopé (multi-tenant) : un membre banni OU supprimé par un admin
// reste exclu du dashboard même si son UserProfile a été purgé (RGPD / cleanup).
// Sans cette table, deleteProfileByAdmin() recréait automatiquement un profil
// au prochain accès → l'exclusion était contournée (F-01).
model GuildMemberBan {
  id           String       @id @default(cuid())
  guildId      String
  discordId    String
  reason       String
  bannedBy     String
  bannedByName String?
  // #105 — pseudo/nickname du membre exclu, affiché dans l'onglet « Exclus »
  // (au lieu de l'ID Discord brut) même après anonymisation/purge du profil.
  memberName   String?
  createdAt    DateTime     @default(now())
  liftedAt     DateTime?
  liftedBy     String?
  liftedByName String?
  guild        GuildConfig  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, discordId])
  @@index([guildId])
  @@index([discordId])
}

model BlacklistEntry {
  id               String      @id @default(cuid())
  guildId          String
  content          String
  addedById        String
  addedByName      String
  createdAt        DateTime    @default(now())
  discordMessageId String?     @unique
  updatedAt        DateTime    @default(now()) @updatedAt
  guild            GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([createdAt])
  @@index([discordMessageId])
}

model PlatformConfig {
  id                     String   @id @default("singleton")
  hubChannelId           String?
  updatedAt              DateTime @updatedAt
  serviceStatusChannelId String?
  ticketAutoRoleId       String?
  ticketSupportGuildId   String?
  roadmapEnabled         Boolean  @default(false)
  statusIsLite           Boolean  @default(false)
  statusMode             String   @default("living")
  statusFrequency        Int      @default(15)
  statusMention          String   @default("none")
  nsfwFilterEnabled      Boolean  @default(true)
  geoguesserBlacklist    Int[]    @default([])
  godNotifyChannelId     String?
  godNotifyRoleId        String?
  godNotifyWebEnabled    Boolean  @default(true)
  geoguesserReportedMaps Int[]    @default([])
  donationsEnabled       Boolean  @default(true)
  kofiChannelId          String?  // Salon Discord public des remerciements Ko-fi (#DONS-KOFI)
  maintenanceMode        Boolean  @default(false)
  maintenanceMessage     String?
  // Kill-switch God de l'auto-onboarding : OFF = les NOUVELLES guildes ne sont
  // plus déployables en autonomie (file God) ; guildes existantes intouchées.
  autoOnboardingEnabled  Boolean  @default(true)
  questFeedbackChannelId String?  // Canal Discord dédié aux feedbacks Dofus
  // Toggle God : si le ladder Ankama est indisponible, on autorise la saisie
  // manuelle du pseudo Dofus à la place de la vérification Ankama.
  ladderManualFallback  Boolean  @default(false)
  ladderManualFallbackUpdatedAt DateTime?
  ladderManualFallbackUpdatedBy String?
  // Enable / disable the quest local search fallback (siphon local + dofusdb)
  questSearchLocalFirst  Boolean  @default(true)
  // Chantier #68 — Icône affichée dans le bloc d'en-tête des pages quêtes par Dofus
  // (choix God : "serie-de-quete" | "icone-succes")
  dofusQuestHeaderIcon String   @default("serie-de-quete")
  dofusQuestHeaderIconUpdatedAt DateTime?
  dofusQuestHeaderIconUpdatedBy String?
  // Chantier #72 — Toggle God : désactive globalement les permissions RBAC
  // individuelles (« Membres Spécifiques », usersMapping). Kill-switch fail-closed :
  // off → getUserContext ignore totalement usersMapping et updateRBACMapping refuse
  // toute modification des permissions individuelles.
  rbacUsersMappingEnabled Boolean @default(true)
  rbacUsersMappingUpdatedAt DateTime?
  rbacUsersMappingUpdatedBy String?
  // Chantier #16 — Toggle God « Forcer le mode sombre » (kill-switch fail-closed) :
  // quand il est actif, le thème est verrouillé en DARK pour tout le monde (bascule
  // auto même si un user avait laissé le mode clair) et les boutons clair/sombre
  // deviennent inopérants.
  forceDarkMode Boolean @default(false)
  forceDarkModeUpdatedAt DateTime?
  forceDarkModeUpdatedBy String?
}

/// Délégation d'accès au dashboard God (sub-gods) avec scopes granulaires.
/// Sécurité fail-closed : par défaut aucun scope.
model GodDelegate {
  id        String   @id @default(cuid())
  userId    String
  guildId   String?
  scopes       String[] // ex: ["guilds", "game-data", "users", "logs", "news", "maintenance"]
  scopeVersion Int       @default(0) // R4 : bump à chaque révocation
  grantedBy    String
  grantedAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([guildId])
  @@index([revokedAt])
}

model GodNotification {
  id        String        @id @default(cuid())
  title     String
  message   String
  type      GodNotifyType
  success   Boolean       @default(true)
  metadata  Json?
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
}

/// R4 : Journal des accès God (révocation live, audit exhaustif).
model GodAccessLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Tentative de connexion REFUSÉE (observabilité God / fail-closed).
// Enregistrée dans le callback `signIn` quand un utilisateur Discord n'est pas
// autorisé (aucune guilde gérée, API Discord KO sans profil connu, etc.).
// PII minimale : uniquement l'ID Discord + le motif + la date. Purge > 90 jours
// via scripts/database-janitor.ts (rétention bornée, conformité RGPD).
model AccessAttempt {
  id        String   @id @default(cuid())
  discordId String
  reason    String   // NO_MANAGED_GUILD | DISCORD_API_ERROR | ...
  createdAt DateTime @default(now())

  @@index([discordId])
  @@index([createdAt])
}

/// R4 : Suivi de session God.
model GodSessionLog {
  id          String    @id @default(cuid())
  userId      String
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime?
  endedAt     DateTime?
  active      Boolean   @default(true)

  @@index([userId])
  @@index([active])
}

/// D1 : Grant granulaire par BRIQUE (PIM) — accès à une brick précise du panel.
/// brickId = slug public (jamais le secret). Fail-closed : un grant doit être
/// actif (startAt <= now), non expiré (expiresAt >= now), non révoqué.
model GodAccessGrant {
  id          String   @id @default(cuid())
  delegateId String   // = id du GodDelegate
  userId     String   // userId cible (redondant avec delegate, pour requêtes rapides)
  brickId    String   // slug de la brique (god-bricks.ts)
  guildId    String?
  startAt    DateTime @default(now())
  expiresAt  DateTime?
  grantedBy  String
  reason     String?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([delegateId])
  @@index([userId])
  @@index([brickId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model RoadmapItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("TODO")
  quarter     String
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([quarter])
}

model MiniGameStatus {
