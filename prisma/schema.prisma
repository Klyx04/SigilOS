generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -- Auth.js Models --

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // SigilOS Relations
  profiles      UserProfile[]
  notifications Notification[]
}

// -- SigilOS Core Models --

model GuildConfig {
  id             String        @id @default(cuid())
  discordGuildId String        @unique
  name           String
  iconUrl        String?
  isActive       Boolean       @default(true)
  rolesMapping   Json          @default("{}") // Record<DiscordRoleId, PermissionId[]>
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profiles       UserProfile[]
  missions       Mission[]
}

model UserProfile {
  id          String      @id @default(cuid())
  userId      String
  guildId     String
  
  status      ProfileStatus @default(ACTIVE)
  
  pseudoDofus String?
  classe      String?
  metiers     Json?       // List of enabled jobs (e.g. ["Costumage", "Alchimiste"])
  succes      Json?       // List of validated achievements
  
  xp          Int         @default(0) // Experience points
  guildatons  Int         @default(0) // Currency
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild       GuildConfig @relation(fields: [guildId], references: [id], onDelete: Cascade)
  submissions Submission[]
  interests   MissionInterest[]

  @@unique([userId, guildId])
}

model Mission {
  id          String         @id @default(cuid())
  guildId     String
  
  category    MissionCategory
  status      MissionStatus  @default(ACTIVE)
  tier        Int            // Rank 1-4 (Dofus Levels)
  
  xpReward          Int?     // Guild XP (Purple Star)
  guildatonsReward  Int?     // Personal Currency (Yellow Coin)
  
  title       String?        // Optional override title
  payload     Json           // Mission details (Boss, Zone, etc)
  
  weekNumber  Int
  year        Int
  slotIndex   Int            @default(0) // 0-11
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  guild       GuildConfig    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  submissions Submission[]
  interests   MissionInterest[]

  @@unique([guildId, weekNumber, year, slotIndex])
  @@index([guildId, weekNumber, year])
}

model MissionInterest {
  id        String      @id @default(cuid())
  missionId String
  profileId String
  
  createdAt DateTime    @default(now())
  
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([missionId, profileId])
}

model Submission {
  id          String           @id @default(cuid())
  missionId   String
  profileId   String
  
  status      SubmissionStatus @default(PENDING)
  proofUrl    String
  validatorId String?
  
  // OCR Analysis Results
  ocrScore    Float?           // 0-100 confidence score
  ocrResult   Json?            // { matches: [...], rawText: string }
  ocrStatus   OcrStatus        @default(PENDING)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  mission     Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  profile     UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// -- Game Data (Reference Tables) --

model Dungeon {
  id        String   @id @default(cuid())
  name      String   @unique
  bossName  String
  level     Int
  dpnlUrl   String?  // Lien dofuspourlesnoobs
  imageUrl  String?  // Image du boss
  createdAt DateTime @default(now())
}

model Zone {
  id        String    @id @default(cuid())
  name      String    @unique
  level     Int
  dpnlUrl   String?
  monsters  Monster[]
  createdAt DateTime  @default(now())
}

model Monster {
  id        String   @id @default(cuid())
  name      String
  zoneId    String
  imageUrl  String?
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@index([zoneId])
}

// -- Enums --

enum ProfileStatus {
  ACTIVE
  ARCHIVED
  BANNED
}

enum MissionCategory {
  DONJON
  REGULATION
  ANOMALIE
  SONGES
  EXPEDITION
  EVENT
}

enum MissionStatus {
  ACTIVE
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum AnomalieType {
  ZONE
  BOSS
}

enum SongesDifficulty {
  REVE
  PARADOXE
  CAUCHEMAR
}

enum ExpeditionMode {
  BRAVOURE
  AUDACE
  AUCUN
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  MISSION_VALIDATED
  MISSION_REJECTED
  NEW_SUBMISSION_PENDING
  SYSTEM_INFO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  link      String?          // Optional redirection link
  
  createdAt DateTime         @default(now())
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}
