model Bounty {
  id         String   @id @default(cuid())
  name       String
  level      Int
  zoneName   String?
  imageUrl   String?
  reward     String?
  levelMin   Int?
  levelMax   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  dpnlUrl    String?
  doplons    Int      @default(0)
  mechanics  String?
  milice     String?
  rewardType String   @default("Doplon")
  mapUrl     String?
  rewards    Json?    @default("[]")
  position   String?
  /* ── Chantier « Avis de recherche » (fiches + Succès + overlay) ────────────────
     Contenu 100 % SIPHONNÉ (DofusDB `monster-races/32|90|127|147|156` + Dofensive
     `/monsters/{id}`), écrit par la phase 4 du cron `sync-monster-stats` : jamais saisi
     à la main (règle de la maison). `dofusdbId` = id Ankama/DofusDB, **clé de
     rattachement** — des homonymes existent (3 × « Ronce ») donc `name` n'est plus
     unique. `isBountyMonster` marque les 96 avis siphonnés ; les lignes historiques
     (archimonstres/boss utilisés par la carte du monde) restent à `false` et ne sont
     jamais servies comme avis. `subareaIds` = sous-zones de traque (worldmap.json) ;
     `battleMapId`/`battleMapSource` = carte de la simulation (`default` = repli
     DÉCLARÉ : Dofensive n'expose pas la grille des maps sauvages). */
  dofusdbId       Int?     @unique
  slug            String?
  raceId          Int?
  raceName        String?
  subareaIds      Json     @default("[]")
  isBountyMonster Boolean  @default(false)
  battleMapId     Int?
  battleMapSource String?
  dofusdbSyncedAt DateTime?

  @@index([name])
  @@index([zoneName])
  @@index([isBountyMonster])
}

/// Catalogue de monstres/boss/archimonstres de Dofus — stockés localement pour la carte.
/// Synchronisés depuis Metamob (zones) + DofusDB (image, level, subareaId).
/// `isOcre=true` pour les membres de la Quête Ocre (Éternelle Moisson).
model Archimonstre {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("archimonstre") // archimonstre | boss | monstre
  isOcre      Boolean  @default(false)           // Membre de la Quête Ocre (archis + boss)
  imageUrl    String?
  level       Int      @default(0)
  dofusdbId   Int?
  zone        String?  // Zone principale (Metamob)
  subzone     String?  // Sous-zone (Metamob)
  subareaIds  Json     @default("[]")   // IDs worldmap.json pour le highlight
  worldMapId  Int      @default(1)      // Monde Dofus (1=Monde des Douze, 2=Frigost, etc.)
  centerX     Float?   // Coordonnée X représentative pour centrer la carte
  centerY     Float?   // Coordonnée Y représentative pour centrer la carte
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, type]) // Les monstres normaux Dofus peuvent avoir des homonymes (type différent)
  @@index([name])
  @@index([type])
  @@index([isOcre])
  @@index([dofusdbId])
}

